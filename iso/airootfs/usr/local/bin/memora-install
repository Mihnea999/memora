#!/usr/bin/env bash
# memora-install — installs Memora from the live ISO onto a disk.
#
# Unattended test mode: boot with "memora.auto" on the kernel command line
# (optionally "memora.encrypt") and it installs to the first disk with user
# memora / password memora, then powers off.
set -Eeuo pipefail

PAYLOAD=/opt/memora
LOG=/var/log/memora-install.log
TARGET=/mnt
MiB=$((1024 * 1024)); GiB=$((1024 * MiB))
MODE=erase; SIZE=0; ESP_PART=""
AUTO=0; grep -qw memora.auto /proc/cmdline && AUTO=1
# Graphical installer: `memora-install --answers FILE` takes every answer from
# FILE (shell variables) and reports progress as "@step N TOTAL text" lines.
GUI=0; ANSWERS=""
if [[ ${1:-} == --answers ]]; then GUI=1; ANSWERS=$2; fi

: > "$LOG"
log() { printf '[%(%H:%M:%S)T] %s\n' -1 "$*" >> "$LOG"; }

accent=255
STEP=0
title() { if [[ $GUI == 1 ]]; then STEP=$((STEP + 1)); echo "@step $STEP 3 $*"; else gum style --foreground "$accent" --bold "$*"; fi; }
info() { [[ $GUI == 1 ]] && echo "$*" || gum style --foreground 245 "$*"; }
REPORTED=0
fail() { REPORTED=1; log "$*"; [[ $GUI == 1 ]] && echo "@error $*" || gum style --foreground 203 --bold "$*"; }

on_error() {
  local line=$1
  log "error at line $line"
  echo
  if [[ $REPORTED == 0 ]]; then
    fail "Installation failed (line $line). Full log: $LOG"
    [[ $GUI == 1 ]] && echo "@error Installation failed. Details are in $LOG"
  fi
  [[ $GUI == 1 ]] || tail -n 15 "$LOG" 2>/dev/null || true
  cleanup
  if [[ $AUTO == 1 ]]; then sleep 5; poweroff; fi
  exit 1
}
trap 'on_error $LINENO' ERR

cleanup() {
  swapoff -a 2>/dev/null || true
  umount -R "$TARGET" 2>/dev/null || true
  cryptsetup close cryptroot 2>/dev/null || true
}

banner() {
  [[ $GUI == 1 ]] && return 0
  clear
  gum style --border rounded --border-foreground "$accent" --padding "1 4" --margin "1 2" \
    "$(gum style --foreground "$accent" --bold 'Memora')" \
    "$(gum style --foreground 245 "Installer $(cat $PAYLOAD/version)")"
}

ask() { # ask VAR "header" [default] [--password]
  local __var=$1 header=$2 def=${3:-} pw=${4:-} val
  while true; do
    if [[ $pw == --password ]]; then
      val="$(gum input --password --header "$header" --placeholder "$def")"
    else
      val="$(gum input --header "$header" --value "$def")"
    fi
    [[ -n $val ]] && break
  done
  printf -v "$__var" '%s' "$val"
}

# ---------------------------------------------------------------- checks
preflight() {
  [[ $EUID -eq 0 ]] || { echo "Run as root."; exit 1; }
  if [[ ! -d /sys/firmware/efi ]]; then
    fail "This computer booted in legacy BIOS mode."
    info "Memora needs UEFI. Enable UEFI boot in the firmware settings and boot the USB again."
    exit 1
  fi
}

online() { curl -sfI --max-time 5 https://geo.mirror.pkgbuild.com >/dev/null; }

network() {
  online && return 0
  [[ $GUI == 1 ]] && { fail "No internet connection. Connect to a network and try again."; exit 1; }
  [[ $AUTO == 1 ]] && { sleep 10; online && return 0; fail "No network"; exit 1; }
  title "Network"
  info "An internet connection is needed to download packages."
  while ! online; do
    local dev ssid pass
    dev="$(iwctl device list 2>/dev/null | awk '/station/ {print $2; exit}')"
    if [[ -z $dev ]]; then
      info "No Wi-Fi adapter found. Plug in an Ethernet cable, then press Enter."
      read -r _; continue
    fi
    iwctl station "$dev" scan; sleep 3
    ssid="$(iwctl station "$dev" get-networks | sed -e 's/\x1b\[[0-9;]*m//g' | awk 'NR>4 && NF {sub(/^ *> */,""); print}' |
      awk '{ $NF=""; $(NF-1)=""; sub(/ +$/,""); print }' | grep -v '^$' | gum choose --header "Wi-Fi network")" || continue
    pass="$(gum input --password --header "Password for $ssid (empty for open networks)")"
    if [[ -n $pass ]]; then iwctl --passphrase "$pass" station "$dev" connect "$ssid" || true
    else iwctl station "$dev" connect "$ssid" || true; fi
    gum spin --title "Connecting..." -- sleep 6
    online || fail "Still offline. Try again."
  done
}

# ---------------------------------------------------------------- questions
live_disk() {
  local src
  src="$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
  [[ -n $src ]] && lsblk -no PKNAME "$src" 2>/dev/null | head -1
}

pick_disk() {
  local live; live="$(live_disk || true)"
  mapfile -t disks < <(lsblk -dpno NAME,SIZE,MODEL,TYPE | awk '$NF=="disk"' |
    grep -vE '^/dev/(loop|sr|zram|fd)' | { if [[ -n $live ]]; then grep -v "^/dev/$live "; else cat; fi } |
    sed 's/ *disk$//')
  ((${#disks[@]})) || { fail "No disk found to install on."; exit 1; }
  if [[ $AUTO == 1 ]]; then DISK="${disks[0]%% *}"; return; fi
  title "Disk"
  local sel; sel="$(printf '%s\n' "${disks[@]}" | gum choose --header "Install Memora on (everything on it will be erased):")"
  DISK="${sel%% *}"
}

pick_keyboard() {
  local rows=(
    "English (US)|us|us" "Romanian|ro_std|ro" "English (UK)|uk|gb" "German|de-latin1|de"
    "French|fr|fr" "Spanish|es|es" "Italian|it|it" "Polish|pl|pl" "Hungarian|hu|hu"
  )
  local sel="English (US)"
  [[ $AUTO == 1 ]] || sel="$(printf '%s\n' "${rows[@]%%|*}" | gum choose --header "Keyboard layout")"
  for r in "${rows[@]}"; do
    if [[ ${r%%|*} == "$sel" ]]; then IFS='|' read -r _ KEYMAP XKB <<<"$r"; fi
  done
  loadkeys "$KEYMAP" 2>/dev/null || true
}

questions() {
  if [[ $GUI == 1 ]]; then
    # shellcheck disable=SC1090
    source "$ANSWERS"
    shred -u "$ANSWERS" 2>/dev/null || rm -f "$ANSWERS"
    [[ -b $DISK ]] || { fail "The chosen disk is gone."; exit 1; }
    MODE=${MODE:-erase}; SIZE=${SIZE:-0}
    [[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { fail "Invalid username."; exit 1; }
    [[ $HOSTNAME_ =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] || HOSTNAME_=memora
    loadkeys "$KEYMAP" 2>/dev/null || true
    return
  fi
  if [[ $AUTO == 1 ]]; then
    pick_disk; pick_keyboard
    FULLNAME="Memora"; USERNAME=memora; PASSWORD=memora; HOSTNAME_=memora
    TIMEZONE=UTC; LOCALE=en_US.UTF-8; THEME=dark; TOOLKITS=""
    ENCRYPT=0; if grep -qw memora.encrypt /proc/cmdline; then ENCRYPT=1; fi
    # memora.alongside: keep what is on the disk and make 32 GiB of room.
    MODE=erase; SIZE=0
    if grep -qw memora.alongside /proc/cmdline; then MODE=alongside; SIZE=$((32 * GiB)); fi
    return
  fi

  title "Keyboard"; pick_keyboard
  title "You"
  ask FULLNAME "Full name" ""
  while true; do
    ask USERNAME "Username" "$(tr '[:upper:]' '[:lower:]' <<<"${FULLNAME%% *}" | tr -cd 'a-z0-9_-')"
    [[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && break
    fail "Use lowercase letters, digits, - and _ (start with a letter)."
  done
  while true; do
    ask PASSWORD "Password (also used for sudo)" "" --password
    local again; ask again "Repeat password" "" --password
    [[ $PASSWORD == "$again" ]] && break
    fail "Passwords do not match."
  done
  while true; do
    ask HOSTNAME_ "Computer name" "memora"
    [[ $HOSTNAME_ =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] && break
    fail "Letters, digits and - only."
  done

  title "Region"
  TIMEZONE="$(timedatectl list-timezones | gum filter --placeholder "Type a city, e.g. Bucharest" --header "Time zone")"
  LOCALE="$(printf '%s\n' en_US.UTF-8 en_GB.UTF-8 ro_RO.UTF-8 de_DE.UTF-8 fr_FR.UTF-8 es_ES.UTF-8 it_IT.UTF-8 |
    gum choose --header "Language and formats")"

  pick_disk; MODE=erase
  if gum confirm --default=yes "Encrypt the disk? (recommended; you type the password at boot)"; then ENCRYPT=1; else ENCRYPT=0; fi

  title "Look"
  THEME="$(printf '%s\n' dark light | gum choose --header "Appearance: dark or light glass (switch any time with Super+T)")"

  title "Developer tools"
  TOOLKITS="$(printf '%s\n' \
    "gaming    Steam, Proton, GameMode" "node      Node.js LTS (mise)" "claude    Claude Code CLI" "python    Python + uv (mise)" \
    "docker    Docker + Compose" "ollama    Local AI models" "flutter   Flutter SDK" \
    "android   Android adb + JDK" "rust      Rust (rustup)" "go        Go (mise)" |
    gum choose --no-limit --selected "gaming    Steam, Proton, GameMode,node      Node.js LTS (mise),claude    Claude Code CLI" \
      --header "Install now (space to toggle, enter to continue). More later with: memora dev" |
    awk '{print $1}' | paste -sd' ')" || TOOLKITS=""
}

confirm() {
  [[ $AUTO == 1 || $GUI == 1 ]] && return 0
  banner
  gum style --border normal --padding "0 2" --border-foreground 240 \
    "Disk        $DISK  (will be erased)" \
    "Encryption  $([[ $ENCRYPT == 1 ]] && echo yes || echo no)" \
    "User        $USERNAME ($FULLNAME)" \
    "Computer    $HOSTNAME_" \
    "Time zone   $TIMEZONE" \
    "Language    $LOCALE" \
    "Keyboard    $XKB" \
    "Theme       $THEME" \
    "Toolkits    ${TOOLKITS:-none}"
  gum confirm --default=no "Erase $DISK and install Memora?" || { info "Nothing was changed."; exit 1; }
}

# ---------------------------------------------------------------- install
part() { [[ $1 =~ [0-9]$ ]] && echo "${1}p$2" || echo "${1}$2"; }

prepare_disk() {
  log "disk $DISK mode=$MODE size=$SIZE encrypt=$ENCRYPT"
  cleanup
  if [[ $MODE == alongside ]]; then make_room; else erase_disk; fi
  format_root
  mount_all
}

# The whole disk for Memora: a 2 GiB EFI partition and the rest.
erase_disk() {
  title "Preparing $DISK"
  wipefs -af "$DISK" >> "$LOG" 2>&1
  sgdisk --zap-all "$DISK" >> "$LOG" 2>&1
  sgdisk -n1:0:+2G -t1:ef00 -c1:MEMORA_EFI -n2:0:0 -t2:8309 -c2:MEMORA "$DISK" >> "$LOG" 2>&1
  [[ $ENCRYPT == 1 ]] || sgdisk -t2:8300 "$DISK" >> "$LOG" 2>&1
  settle
  BOOT_PART="$(part "$DISK" 1)"; ROOT_PART="$(part "$DISK" 2)"
  mkfs.fat -F32 -n MEMORA_EFI "$BOOT_PART" >> "$LOG" 2>&1
}

settle() { partprobe "$DISK" 2>/dev/null || true; udevadm settle; sleep 1; }

# Next to what is already there: in free space, or in room made by shrinking
# the partition memora-disks picked (NTFS or ext4). Kernels go on a small
# partition of Memora's own (XBOOTLDR); the boot menu goes on the existing EFI
# partition, where it also finds Windows.
make_room() {
  title "Making room on $DISK"
  local info; info="$(memora-disks "$DISK" | jq -c '.[0]')"
  log "disk: $info"
  [[ $(jq -r .pttype <<<"$info") == gpt ]] || { fail "This disk uses the older MBR layout, so Memora can't be installed next to what's on it."; false; }
  local free need ss al
  free=$(jq .free <<<"$info"); ESP_PART=$(jq -r .esp <<<"$info")
  need=$(( SIZE / MiB * MiB ))
  (( need >= 20 * GiB )) || { fail "Memora needs at least 20 GB."; false; }
  ss=$(blockdev --getss "$DISK"); al=$(( MiB / ss ))

  if (( free < need )); then
    local sp fstype psize state room
    IFS=$'\x1f' read -r sp fstype psize state room < <(jq -r '.shrink // {} | [.part // "", .fstype // "", (.size // 0 | tostring), .state // "", (.room // 0 | tostring)] | join("\u001f")' <<<"$info")
    [[ -n $sp ]] || { fail "There isn't enough free space on this disk."; false; }
    case $state in
      ok) ;;
      hibernated) fail "Windows didn't shut down completely (Fast Startup). Start Windows, hold Shift while you click Shut Down, then try again."; false ;;
      dirty) fail "Windows needs to check its disk first. Start Windows, restart it once, shut it down, then try again."; false ;;
      locked) fail "Windows is encrypted with BitLocker, so it can't be resized from here. In Windows, open Disk Management, right-click C: and choose Shrink Volume (30 GB or more), then start the installer again."; false ;;
      *) fail "$sp can't be resized safely."; false ;;
    esac
    # A rounding difference (the installer counts whole gigabytes) is fine.
    (( need > room && need - room < 2 * GiB )) && need=$room
    (( need <= room )) || { fail "There's only room for $((room / 1000000000)) GB next to the other system."; false; }
    local newsize=$(( (psize - need) / MiB * MiB ))
    info "Resizing $sp to $((newsize / GiB)) GB"
    log "shrink $sp ($fstype) $psize -> $newsize"
    case $fstype in
      ntfs)
        ntfsresize --no-action --no-progress-bar --size "$newsize" "$sp" >> "$LOG" 2>&1
        printf 'y\n' | ntfsresize --no-progress-bar --size "$newsize" "$sp" >> "$LOG" 2>&1 ;;
      ext4)
        e2fsck -f -y "$sp" >> "$LOG" 2>&1 || (( $? < 4 ))
        resize2fs "$sp" "$(( newsize / 1024 ))K" >> "$LOG" 2>&1 ;;
      *) false ;;
    esac
    local n; n="$(lsblk -no PARTN "$sp" | tr -d ' ')"
    echo ",$(( newsize / ss ))" | sfdisk --no-reread --no-tell-kernel --wipe never --wipe-partitions never -q -N "$n" "$DISK" >> "$LOG" 2>&1
    settle
  fi

  # The biggest free stretch is the one to use (the new one, after shrinking).
  local start end
  read -r start end < <(LC_ALL=C parted -m -s "$DISK" unit s print free |
    awk -F: '$5 ~ /^free/ { s = $2; e = $3; sub(/s$/, "", s); sub(/s$/, "", e); if (e - s > m) { m = e - s; bs = s; be = e } } END { print bs, be }')
  start=$(( (start + al - 1) / al * al ))
  local limit=$(( start + need / ss - 1 )); (( limit > end )) && limit=$end
  (( (limit - start) * ss >= 20 * GiB )) || { fail "There isn't enough free space on this disk."; false; }

  local used nb nr i=1
  used=" $(lsblk -lno PARTN "$DISK" | tr '\n' ' ') "
  while [[ $used == *" $i "* ]]; do i=$((i + 1)); done; nb=$i; i=$((i + 1))
  while [[ $used == *" $i "* ]]; do i=$((i + 1)); done; nr=$i
  local bend=$(( start + 2 * GiB / ss - 1 ))
  if [[ -n $ESP_PART ]]; then
    sgdisk -n "$nb:$start:$bend" -t "$nb:ea00" -c "$nb:MEMORA_BOOT" "$DISK" >> "$LOG" 2>&1
  else
    sgdisk -n "$nb:$start:$bend" -t "$nb:ef00" -c "$nb:MEMORA_EFI" "$DISK" >> "$LOG" 2>&1
  fi
  sgdisk -n "$nr:$(( bend + 1 )):$limit" -t "$nr:$([[ $ENCRYPT == 1 ]] && echo 8309 || echo 8300)" -c "$nr:MEMORA" "$DISK" >> "$LOG" 2>&1
  settle
  BOOT_PART="$(part "$DISK" "$nb")"; ROOT_PART="$(part "$DISK" "$nr")"
  log "boot $BOOT_PART root $ROOT_PART esp ${ESP_PART:-none}"
  mkfs.fat -F32 -n MEMORA_BOOT "$BOOT_PART" >> "$LOG" 2>&1
}

format_root() {
  local dev=$ROOT_PART
  if [[ $ENCRYPT == 1 ]]; then
    printf '%s' "$PASSWORD" | cryptsetup luksFormat --type luks2 --batch-mode --pbkdf argon2id \
      --label MEMORA_LUKS --key-file=- "$ROOT_PART" >> "$LOG" 2>&1
    printf '%s' "$PASSWORD" | cryptsetup open --allow-discards --key-file=- "$ROOT_PART" cryptroot >> "$LOG" 2>&1
    dev=/dev/mapper/cryptroot
    LUKS_UUID="$(blkid -s UUID -o value "$ROOT_PART")"
  fi
  mkfs.btrfs -f -L memora "$dev" >> "$LOG" 2>&1
  ROOT_UUID="$(blkid -s UUID -o value "$dev")"
  ROOT_DEV=$dev
}

mount_all() {
  local dev=$ROOT_DEV
  mount "$dev" "$TARGET"
  for sv in @ @home @log @pkg @snapshots; do btrfs subvolume create "$TARGET/$sv" >> "$LOG"; done
  umount "$TARGET"
  local o=noatime,compress=zstd:1
  mount -o "$o,subvol=@" "$dev" "$TARGET"
  mkdir -p "$TARGET"/{boot,home,var/log,var/cache/pacman/pkg,.snapshots}
  mount -o "$o,subvol=@home" "$dev" "$TARGET/home"
  mount -o "$o,subvol=@log" "$dev" "$TARGET/var/log"
  mount -o "$o,subvol=@pkg" "$dev" "$TARGET/var/cache/pacman/pkg"
  mount -o "$o,subvol=@snapshots" "$dev" "$TARGET/.snapshots"
  mount -o umask=0077 "$BOOT_PART" "$TARGET/boot"
  # Next to another system: its EFI partition holds the boot menu.
  if [[ -n $ESP_PART ]]; then
    mkdir -p "$TARGET/efi"
    mount -o umask=0077 "$ESP_PART" "$TARGET/efi"
  fi
}

package_list() {
  cat "$PAYLOAD"/packages/{base,desktop,cli}.txt | sed 's/#.*//' | awk 'NF'
  grep -q GenuineIntel /proc/cpuinfo && echo intel-ucode
  grep -q AuthenticAMD /proc/cpuinfo && echo amd-ucode
  return 0
}

# Puts the fastest mirrors first: each candidate downloads for up to 4 seconds,
# all at once. A slow mirror can otherwise make the install take an hour.
fastest_mirrors() {
  local list=/etc/pacman.d/mirrorlist tmp; tmp="$(mktemp -d)"
  {
    grep -oP '^Server\s*=\s*\K\S+' "$list" 2>/dev/null | head -20
    printf '%s\n' https://geo.mirror.pkgbuild.com/'$repo/os/$arch' https://fastly.mirror.pkgbuild.com/'$repo/os/$arch' \
      https://mirror.rackspace.com/archlinux/'$repo/os/$arch' https://mirrors.nxthost.com/archlinux/'$repo/os/$arch' \
      https://mirror.efect.ro/archlinux/'$repo/os/$arch' https://ftp.fau.de/archlinux/'$repo/os/$arch' \
      https://mirror.leaseweb.net/archlinux/'$repo/os/$arch' https://mirrors.kernel.org/archlinux/'$repo/os/$arch' \
      https://mirror.osbeck.com/archlinux/'$repo/os/$arch' https://archlinux.mirror.liteserver.nl/'$repo/os/$arch'
  } | awk '!seen[$0]++' > "$tmp/all"
  local i=0 m
  while read -r m; do
    i=$((i + 1))
    ( u=${m//\$repo/extra}; u=${u//\$arch/x86_64}
      s=$(curl -s -o /dev/null -w '%{speed_download}' --max-time 4 "$u/extra.db" | sed 's/[.,].*//')
      echo "${s:-0} $m" > "$tmp/$i" ) &
  done < "$tmp/all"
  wait
  local best; best="$(cat "$tmp"/[0-9]* 2>/dev/null | sort -rn | awk '$1 > 0 {print "Server = " $2}' | head -8)"
  if [[ -n $best ]]; then
    cp "$list" "$list.orig" 2>/dev/null || true
    printf '# Fastest from here when Memora was installed.\n%s\n' "$best" > "$list"
    log "mirrors: $(echo "$best" | head -3 | tr '\n' ' ')"
  fi
  rm -rf "$tmp"
  sed -i 's/^#\?ParallelDownloads.*/ParallelDownloads = 8/' /etc/pacman.conf
}

install_base() {
  title "Downloading and installing packages"
  info "This takes a few minutes, depending on your connection."
  info "Finding the fastest download server…"
  fastest_mirrors || true
  mapfile -t pkgs < <(package_list)
  log "pacstrap ${#pkgs[@]} packages"
  # A server that was quick for the speed test can still stall on big files:
  # then drop the servers that failed and go again (what's downloaded stays).
  local try bad h list=/etc/pacman.d/mirrorlist
  for try in 1 2 3; do
    pacstrap -K "$TARGET" "${pkgs[@]}" 2>&1 | tee -a "$LOG" | grep --line-buffered -E '^(::|\([ 0-9]+/[0-9]+\) installing)' |
      if [[ $GUI == 1 ]]; then sed -nu 's/^(\s*\([0-9]*\)\/\([0-9]*\)) installing \(.*\)\.\.\..*/@pkg \1 \2 \3/p'; else cat; fi || true
    [[ -x $TARGET/usr/bin/Hyprland || -x $TARGET/usr/bin/hyprland ]] && break
    [[ $try == 3 ]] && { log "pacstrap did not install hyprland"; return 1; }
    bad="$(grep -oP "failed retrieving file '[^']*' from \K\S+" "$LOG" | sort -u)"
    for h in $bad; do sed -i "\|//$h/|d" "$list"; done
    grep -q '^Server' "$list" || cp "$list.orig" "$list" 2>/dev/null || true
    log "pacstrap try $try failed; dropped servers: ${bad:-none}"
    info "A download server stalled. Trying again with another one…"
  done
  genfstab -U "$TARGET" >> "$TARGET/etc/fstab"
}

configure() {
  title "Configuring Memora"
  mkdir -p "$TARGET/usr/share"
  cp -a "$PAYLOAD" "$TARGET/usr/share/memora"
  chmod 755 "$TARGET"/usr/share/memora/{bin/*,install/*.sh,lib/*.sh}
  install -m600 /dev/null "$TARGET/root/memora.env"
  {
    printf 'MEMORA_%s=%q\n' \
      USER "$USERNAME" FULLNAME "$FULLNAME" PASSWORD "$PASSWORD" HOSTNAME "$HOSTNAME_" \
      TIMEZONE "$TIMEZONE" LOCALE "$LOCALE" KEYMAP "$KEYMAP" XKB "$XKB" THEME "$THEME" \
      TOOLKITS "$TOOLKITS" ENCRYPT "$ENCRYPT" LUKS_UUID "${LUKS_UUID:-}" ROOT_UUID "$ROOT_UUID"
  } > "$TARGET/root/memora.env"
  arch-chroot "$TARGET" bash /usr/share/memora/install/chroot.sh 2>&1 | tee -a "$LOG" | grep --line-buffered -E '==>|failed' || true
  [[ -f $TARGET/boot/loader/entries/memora.conf ]] || { log "chroot setup did not finish"; false; }
  [[ ! -f $TARGET/root/memora.env ]] || { log "chroot setup did not finish"; false; }
  ln -sf /run/systemd/resolve/stub-resolv.conf "$TARGET/etc/resolv.conf"
  cp "$LOG" "$TARGET/var/log/memora-install.log"
  if [[ $AUTO == 1 ]]; then
    # Test installs: when the VM shares the source tree (test/vm.sh dev), it replaces
    # /usr/share/memora live, and test/share is writable at /mnt/share.
    mkdir -p "$TARGET/mnt/share"
    printf '%s\n' \
      "memora /usr/share/memora 9p trans=virtio,version=9p2000.L,ro,nofail,x-systemd.device-timeout=2s 0 0" \
      "share /mnt/share 9p trans=virtio,version=9p2000.L,nofail,x-systemd.device-timeout=2s 0 0" >> "$TARGET/etc/fstab"
  fi
}

finish() {
  sync
  cleanup
  if [[ $AUTO == 1 ]]; then echo "MEMORA_INSTALL_OK"; sleep 2; poweroff; exit 0; fi
  if [[ $GUI == 1 ]]; then echo "@done"; exit 0; fi
  banner
  gum style --foreground 114 --bold "Memora is installed."
  info "Remove the USB stick, then restart."
  if gum confirm "Restart now?"; then reboot; fi
}

main() {
  preflight
  banner
  network
  timedatectl set-ntp true 2>/dev/null || true
  questions
  confirm
  prepare_disk
  install_base
  configure
  finish
}

main "$@"
