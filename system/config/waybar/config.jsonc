{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "modules-left": ["image#logo", "hyprland/window"],
  "modules-center": [],
  "modules-right": ["tray", "custom/ai", "bluetooth", "pulseaudio", "battery", "network", "custom/control", "clock"],

  "image#logo": {
    "exec": "echo $HOME/.config/memora/current/logo.png",
    "size": 16,
    "interval": 3600,
    "signal": 8,
    "tooltip": false,
    "on-click": "memora-menu"
  },
  "custom/logo": {
    "format": "󰬔",
    "tooltip-format": "Memora menu",
    "on-click": "memora-menu"
  },
  "custom/control": {
    "format": "󰒓",
    "tooltip-format": "Control center",
    "on-click": "memora-menu"
  },
  "custom/ai": {
    "format": "󰚩",
    "tooltip-format": "Memora AI (Super+A)",
    "on-click": "memora-ai window"
  },
  "hyprland/window": {
    "format": "{class}",
    "rewrite": { "^$": "Desktop", "^kitty$": "Terminal", "^memora-(float|ai|welcome)$": "Memora", "^org\\.gnome\\.Nautilus$": "Files", "^chromium$": "Chromium" },
    "separate-outputs": true,
    "max-length": 28
  },
  "hyprland/workspaces": {
    "format": "●",
    "on-click": "activate",
    "persistent-workspaces": { "*": 3 }
  },
  "clock": {
    "format": "{:%a %b %d   %H:%M}",
    "on-click": "memora-float bash -c 'cal -3; read -rsn1'",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}",
    "on-click": "memora-float impala"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format-connected": "{device_alias}",
    "on-click": "memora-float bluetui"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "tooltip-format": "{volume}%",
    "on-click": "memora-float wiremix",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "cpu": {
    "interval": 5,
    "format": "󰍛",
    "tooltip-format": "CPU {usage}%",
    "on-click": "memora-float btop"
  },
  "battery": {
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "tooltip-format": "{capacity}% · {timeTo}",
    "states": { "warning": 20, "critical": 10 }
  },
  "tray": { "icon-size": 14, "spacing": 10 }
}
