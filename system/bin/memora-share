#!/usr/bin/env python3
"""memora-share — Nearby Share: send and receive files with phones and
computers on the same network. It speaks Quick Share (built into Android
phones and tablets, see ../nearby/quickshare.py) and LocalSend (v2: the
LocalSend app on iPhone, Windows, macOS, Linux and Android).

  memora-share serve              the background service (started with the desktop)
  memora-share scan               look for devices now
  memora-share devices            the devices seen lately (JSON)
  memora-share send ID FILE...    send files to a device (ID from devices);
                                  prints "PROGRESS 0-100", then "DONE" or "ERROR why"
  memora-share receive MODE       who can send you files: everyone, trusted, off
                                  (on = the last of everyone/trusted)
  memora-share trust              the trusted devices (JSON)
  memora-share trust remove ID    stop trusting one
  memora-share autoaccept on|off  take files from trusted devices without asking
  memora-share name NAME          the name others see ("" for the default)

Received files go to Downloads, after you accept them in a notification
(with "Always Accept" the device becomes trusted; trusted devices send
without asking unless autoaccept is off).
Settings: ~/.config/memora/share.json. State for the desktop:
$XDG_RUNTIME_DIR/memora-share/devices.json.
"""
import hashlib
import hmac
import json
import os
import re
import secrets
import shutil
import socket
import ssl
import struct
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

sys.path.insert(0, os.path.join(os.environ.get("MEMORA_PATH", "/usr/share/memora"), "nearby"))
try:
    import quickshare
except ImportError:          # python-cryptography or python-zeroconf missing: LocalSend only
    quickshare = None

PORT = 53317
GROUP = "224.0.0.167"
API = "/api/localsend/v2"
HOME = Path.home()
CONF = HOME / ".config/memora/share.json"
KEYS = HOME / ".local/share/memora/share"
RUN = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "memora-share"
DEVICES = RUN / "devices.json"
SEEN_FOR = 120            # seconds a device stays in the list after it was last heard


def config():
    c = {"receive": True}
    try:
        c.update(json.loads(CONF.read_text()))
    except (OSError, ValueError):
        pass
    return c


def save_config(c):
    CONF.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONF.with_suffix(".tmp")
    tmp.write_text(json.dumps(c, indent=1) + "\n")
    tmp.replace(CONF)


def mode(c=None):
    """Who may send: "everyone", "trusted" or "off" (older configs said true/false)."""
    r = (c or config()).get("receive", True)
    return "everyone" if r is True or r == "everyone" else "trusted" if r == "trusted" else "off"


# Trusted devices: a LocalSend device by its id ("ls:" + fingerprint), an
# Android one by its name ("qs:" + name), the only things that stay the same
# from one transfer to the next. Either can be copied by someone on the same
# network, so this decides about asking, never about opening anything.
def trusted(key):
    return any(t.get("id") == key for t in config().get("trusted") or [])


def trust(key, name, kind):
    c = config()
    c["trusted"] = [t for t in c.get("trusted") or [] if t.get("id") != key] + \
        [{"id": key, "name": name, "kind": kind, "added": int(time.time())}]
    save_config(c)


ASKING = threading.Lock()     # one question on screen at a time


def consent(key, name, kind, question, proven=True):
    """Whether to take what `name` sends: by the mode, the trusted list, or by
    asking. `proven` is False when a device only claims to be a trusted one
    (see proves_identity): then it is asked about like any other.
    Returns True, False, or None when another question is already on screen."""
    c = config()
    m = mode(c)
    if m == "off":
        return False
    known = trusted(key)
    if known and proven and c.get("autoAccept", True):
        return True
    if m == "trusted" and not known:
        return False                       # not asked: strangers don't get to pop up anything
    if not ASKING.acquire(blocking=False):
        return None
    try:
        choice = notify(name, question, [("accept", "Accept"), ("always", "Always Accept"), ("decline", "Decline")], wait=60)
    finally:
        ASKING.release()
    if choice == "always":
        trust(key, name, kind)
    return choice in ("accept", "always")


def peer_fingerprint(ip, port, timeout=4):
    """The id (certificate hash) of the LocalSend device answering at ip:port, or ""."""
    try:
        with socket.create_connection((ip, port), timeout=timeout) as raw:
            with unverified().wrap_socket(raw) as tls:
                return hashlib.sha256(tls.getpeercert(binary_form=True)).hexdigest().upper()
    except (OSError, ValueError):
        return ""


def proves_identity(info, ip):
    """A LocalSend sender names its own id, and ids are announced to the whole
    network, so anyone could claim a trusted one. The device itself answers on
    its port with the certificate that id is the hash of: ask it."""
    try:
        port = int(info.get("port") or PORT)
    except (TypeError, ValueError):
        return False
    if info.get("protocol", "https") != "https" or not 0 < port < 65536:
        return False
    return peer_fingerprint(ip, port) == str(info.get("fingerprint", "")).upper()


def clean_name(name):
    """A file name from another device, safe to create in Downloads."""
    name = os.path.basename(str(name or "").replace("\\", "/")).strip()
    name = "".join("_" if ch in '/\\?%*:|"<>' or ord(ch) < 32 else ch for ch in name)[:200]
    name = name.lstrip(".")           # never a hidden file: it has to show in Downloads
    return name or "file"


def alias():
    """The name others see: the person's name and the computer, like "Mihnea's Memora"."""
    c = config()
    if c.get("alias"):
        return c["alias"]
    full = ""
    try:
        full = subprocess.run(["getent", "passwd", os.environ.get("USER", "")], capture_output=True, text=True).stdout.split(":")[4].split(",")[0]
    except (IndexError, OSError):
        pass
    first = (full or os.environ.get("USER", "")).split(" ")[0].capitalize()
    return f"{first}'s Memora" if first else socket.gethostname()


def tls_files():
    """A self-signed certificate (LocalSend talks HTTPS); its hash is our id."""
    KEYS.mkdir(parents=True, exist_ok=True)
    os.chmod(KEYS, 0o700)
    cert, key = KEYS / "cert.pem", KEYS / "key.pem"
    if not (cert.exists() and key.exists()):
        subprocess.run(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "3650",
                        "-subj", "/CN=Memora", "-keyout", str(key), "-out", str(cert)],
                       check=True, capture_output=True)
        os.chmod(key, 0o600)
    der = ssl.PEM_cert_to_DER_cert(cert.read_text())
    return cert, key, hashlib.sha256(der).hexdigest().upper()


def me(fingerprint, announce=False):
    return {"alias": alias(), "version": "2.1", "deviceModel": "Memora", "deviceType": "desktop",
            "fingerprint": fingerprint, "port": PORT, "protocol": "https", "download": False,
            **({"announce": True} if announce else {})}


def unverified():
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    return ctx


def post(url, body, timeout=10, data=None, headers=None):
    req = urllib.request.Request(url, data=data if data is not None else json.dumps(body).encode(), method="POST",
                                 headers=headers or {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout, context=unverified()) as r:
        raw = r.read()
        return json.loads(raw) if raw else {}


def notify(title, body, actions=(), wait=0):
    """A notification; with actions, waits (up to `wait` s) and returns the one chosen."""
    # Names and file names come from other devices: never an option, never markup.
    esc = lambda t: str(t).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    args = ["notify-send", "-a", "Nearby Share", "-i", "folder-download"]
    if wait:
        args += ["-t", str(wait * 1000)]   # gone when the question is
    for name, label in actions:
        args += ["-A", f"{name}={label}"]
    args += ["--", " ".join(str(title).split())[:120], esc(body)[:600]]
    if actions:
        try:
            return subprocess.run(["timeout", str(wait)] + args, capture_output=True, text=True).stdout.strip()
        except OSError:
            return ""
    subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return ""


# ------------------------------------------------------------------ service ---
class Service:
    def __init__(self):
        self.cert, self.key, self.fp = tls_files()
        self.devices = {}          # fingerprint -> info + ip, seen
        self.sessions = {}         # id -> {files: {id: {...}}, tokens: {id: token}, sender}
        self.lock = threading.Lock()
        self.qs = self.beacon = None
        self.qs_slots = threading.BoundedSemaphore(8)
        RUN.mkdir(parents=True, exist_ok=True)
        if quickshare:
            try:
                self.qs = quickshare.Presence(alias(), self.publish)
                self.beacon = quickshare.Beacon()
            except Exception:
                self.qs = None
        self.publish()

    # -- devices
    def seen(self, info, ip):
        # Anything on the network can send this: garbage must not stop the service.
        if not isinstance(info, dict):
            return
        fp = info.get("fingerprint")
        if not isinstance(fp, str) or not fp or len(fp) > 128 or fp == self.fp:
            return
        try:
            port = int(info.get("port") or PORT)
        except (TypeError, ValueError):
            return
        proto = info.get("protocol") or "https"
        if not 0 < port < 65536 or proto not in ("http", "https"):
            return
        text = lambda v, d: " ".join(str(v or d).split())[:60]
        with self.lock:
            if fp not in self.devices and len(self.devices) >= 64:
                return
            self.devices[fp] = {"id": fp, "alias": text(info.get("alias"), "Device"), "type": text(info.get("deviceType"), "mobile"),
                                "model": text(info.get("deviceModel"), ""), "ip": ip, "port": port,
                                "protocol": proto, "seen": time.time()}
        self.publish()

    def publish(self):
        now = time.time()
        with self.lock:
            self.devices = {k: d for k, d in self.devices.items() if now - d["seen"] < SEEN_FOR}
            devs = list(self.devices.values()) + (self.qs.list() if self.qs else [])
            out = {"me": {"alias": alias(), "id": self.fp}, "receive": mode() != "off",
                   "devices": sorted(devs, key=lambda d: d["alias"].lower())}
        tmp = DEVICES.with_suffix(".tmp")
        tmp.write_text(json.dumps(out, indent=1))
        tmp.replace(DEVICES)

    # -- discovery (multicast, as LocalSend does)
    def announce(self):
        msg = json.dumps(me(self.fp, announce=True)).encode()
        for _ in range(2):
            try:
                with socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP) as s:
                    s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 1)
                    s.sendto(msg, (GROUP, PORT))
            except OSError:
                pass
            time.sleep(0.4)

    def listen(self):
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
        except (AttributeError, OSError):
            pass
        s.bind(("", PORT))
        s.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, struct.pack("4sl", socket.inet_aton(GROUP), socket.INADDR_ANY))
        answered = {}
        while True:
            try:
                data, (ip, _) = s.recvfrom(65536)
                info = json.loads(data)
            except (OSError, ValueError):
                continue
            if not isinstance(info, dict) or info.get("fingerprint") == self.fp:
                continue
            self.seen(info, ip)
            if info.get("announce") or info.get("announcement"):
                # Answer so it sees us too: over HTTP, else back on the group
                # (each address once every few seconds, however often it calls).
                now = time.time()
                answered = {k: t for k, t in answered.items() if now - t < 5}
                if ip in answered or len(answered) > 32:
                    continue
                answered[ip] = now
                threading.Thread(target=self.answer, args=(info, ip), daemon=True).start()

    def answer(self, info, ip):
        try:
            proto, port = info.get("protocol", "https"), int(info.get("port") or PORT)
            if proto not in ("http", "https") or not 0 < port < 65536:
                return
            post(f"{proto}://{ip}:{port}{API}/register", me(self.fp), timeout=4)
        except Exception:
            try:
                with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
                    s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 1)
                    s.sendto(json.dumps(me(self.fp)).encode(), (GROUP, PORT))
            except OSError:
                pass

    def tick(self):
        while True:
            if self.qs:   # visible to Android while receiving is on; follows Wi-Fi changes
                self.qs.visible(mode() != "off", alias())
            self.announce()
            self.publish()
            for _ in range(30):
                time.sleep(1)
                if (RUN / "scan").exists():
                    (RUN / "scan").unlink(missing_ok=True)
                    if self.beacon:   # wake up the Android devices around so they show
                        self.beacon.extend(30)
                    break

    # -- Quick Share (Android)
    def qs_serve(self):
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind(("", quickshare.PORT))
        srv.listen(8)
        while True:
            try:
                sock, _ = srv.accept()
            except OSError:
                continue
            if not self.qs_slots.acquire(blocking=False):
                sock.close()
                continue

            def one(sock=sock):
                try:
                    quickshare.receive(sock, self.qs_ask, self.qs_received, unique, HOME / "Downloads")
                finally:
                    self.qs_slots.release()
            threading.Thread(target=one, daemon=True).start()

    def qs_ask(self, who, files, texts, pin):
        if files:
            what = files[0]["name"] if len(files) == 1 else f"{len(files)} files"
            what += f" ({human(sum(f['size'] for f in files))})"
        else:
            what = "a link" if texts[0]["kind"] == 2 else "some text"
        return bool(consent("qs:" + who, who, "Quick Share", f"wants to send you {what}\nPIN {pin}"))

    def qs_received(self, who, paths, texts):
        if paths:
            what = os.path.basename(paths[0]) if len(paths) == 1 else f"{len(paths)} files"
            threading.Thread(target=self.received, args=(who, what, paths), daemon=True).start()
        for t in texts:
            text = t["text"].strip()
            if t["kind"] == 2:      # a link: offer to open it
                subprocess.Popen(["memora-sound", "done"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if re.match(r"^https?://\S+$", text) and notify(f"Link from {who}", text, [("open", "Open")], wait=300) == "open":
                    subprocess.Popen(["xdg-open", text])
            else:                   # text: it goes to the clipboard
                try:
                    subprocess.run(["wl-copy"], input=text, text=True, timeout=5)
                except (OSError, subprocess.SubprocessError):
                    pass
                subprocess.Popen(["memora-sound", "done"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                notify(f"Text from {who}", "Copied to the clipboard: " + (text[:120] + "…" if len(text) > 120 else text))

    # -- receiving
    def prepare(self, body, ip):
        info, raw = body.get("info"), body.get("files")
        info = info if isinstance(info, dict) else {}
        self.seen(info, ip)
        if mode() == "off":
            return 403, {"message": "Not receiving"}
        # What was offered is what may arrive: each file's name and exact size.
        files = {}
        for fid, f in (raw.items() if isinstance(raw, dict) else []):
            try:
                size = int(f.get("size"))
            except (AttributeError, TypeError, ValueError):
                return 400, {"message": "Every file needs a size"}
            if size < 0 or len(str(fid)) > 128:
                return 400, {"message": "Bad file"}
            files[str(fid)] = {"name": clean_name(f.get("fileName")), "size": size}
        if not files or len(files) > 500:
            return 400, {"message": "No files"}
        fp = info.get("fingerprint")
        if not isinstance(fp, str) or not fp:
            return 403, {"message": "Declined"}
        who = " ".join(str(info.get("alias") or "Someone").split())[:60]
        names = [f["name"] for f in files.values()]
        size = sum(f["size"] for f in files.values())
        what = names[0] if len(names) == 1 else f"{len(names)} files"
        key = "ls:" + fp
        ok = consent(key, who, "LocalSend", f"wants to send you {what} ({human(size)})",
                     proven=not trusted(key) or proves_identity(info, ip))
        if ok is None:
            return 409, {"message": "Busy"}
        if not ok:
            return 403, {"message": "Declined"}
        try:
            if shutil.disk_usage(HOME).free < size + 200_000_000:
                notify("Not enough space", f"{who} wanted to send {human(size)}.")
                return 507, {"message": "Not enough space"}
        except OSError:
            pass
        sid = str(uuid.uuid4())
        tokens = {fid: secrets.token_hex(16) for fid in files}
        with self.lock:
            now = time.time()
            self.sessions = {k: v for k, v in self.sessions.items() if now - v["at"] < 3600}
            self.sessions[sid] = {"files": files, "tokens": tokens, "who": who, "done": set(), "paths": [], "at": now, "ip": ip}
        return 200, {"sessionId": sid, "files": tokens}

    def upload(self, q, handler):
        sid, fid, token = q.get("sessionId", [""])[0], q.get("fileId", [""])[0], q.get("token", [""])[0]
        with self.lock:
            s = self.sessions.get(sid)
            # Each accepted file once, from the device that offered it.
            if not s or not token or not hmac.compare_digest(str(s["tokens"].get(fid, "")), token) \
                    or handler.client_address[0] != s["ip"] or fid in s["done"] or fid in s.get("busy", set()):
                handler.close_connection = True
                return 403, {"message": "Invalid token"}
            s.setdefault("busy", set()).add(fid)
        meta = s["files"][fid]
        part = None
        try:
            try:
                length = int(handler.headers.get("Content-Length") or -1)
            except ValueError:
                length = -1
            if length != meta["size"]:          # not the file that was accepted
                handler.close_connection = True
                return 400, {"message": "Size differs from what was offered"}
            folder = HOME / "Downloads"
            folder.mkdir(parents=True, exist_ok=True)
            dest = unique(folder / meta["name"])
            part = dest.with_name(dest.name + ".part")
            with open(part, "wb") as f:
                left = length
                while left > 0:
                    chunk = handler.rfile.read(min(1 << 20, left))
                    if not chunk:
                        break
                    f.write(chunk)
                    left -= len(chunk)
            if left:
                handler.close_connection = True
                return 400, {"message": "Incomplete"}
            part.replace(dest)
            part = None
        except OSError:
            handler.close_connection = True
            return 500, {"message": "Couldn't save it"}
        finally:
            s["busy"].discard(fid)
            if part:
                part.unlink(missing_ok=True)
        s["done"].add(fid)
        s["paths"].append(str(dest))
        if s["done"] == set(s["files"]):
            self.sessions.pop(sid, None)
            what = os.path.basename(s["paths"][0]) if len(s["paths"]) == 1 else f"{len(s['paths'])} files"
            threading.Thread(target=self.received, args=(s["who"], what, s["paths"]), daemon=True).start()
        return 200, {}

    def received(self, who, what, paths):
        subprocess.Popen(["memora-sound", "done"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        choice = notify(f"Received {what}", f"From {who} · in Downloads", [("open", "Open"), ("show", "Show in Files")], wait=300)
        if choice == "open":
            subprocess.Popen(["xdg-open", paths[0]])
        elif choice == "show":
            subprocess.Popen(["memora-files", os.path.dirname(paths[0])])

    def serve(self):
        svc = self

        class H(BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.1"
            timeout = 60

            def log_message(self, *a):
                pass

            def reply(self, code, body):
                raw = json.dumps(body).encode()
                self.send_response(code)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(raw)))
                self.end_headers()
                self.wfile.write(raw)

            def body(self):
                try:
                    n = int(self.headers.get("Content-Length") or 0)
                    j = json.loads(self.rfile.read(n) or b"{}") if 0 <= n <= 1 << 20 else {}
                except ValueError:
                    return {}
                return j if isinstance(j, dict) else {}

            def do_GET(self):
                if self.path.startswith(f"{API}/info") or self.path.startswith("/api/localsend/v1/info"):
                    return self.reply(200, me(svc.fp))
                self.reply(404, {})

            def do_POST(self):
                u = urllib.parse.urlparse(self.path)
                q = urllib.parse.parse_qs(u.query)
                ip = self.client_address[0]
                if u.path == f"{API}/register":
                    svc.seen(self.body(), ip)
                    return self.reply(200, me(svc.fp))
                if u.path == f"{API}/prepare-upload":
                    return self.reply(*svc.prepare(self.body(), ip))
                if u.path == f"{API}/upload":
                    return self.reply(*svc.upload(q, self))
                if u.path == f"{API}/cancel":
                    svc.sessions.pop(q.get("sessionId", [""])[0], None)
                    return self.reply(200, {})
                self.reply(404, {})

        httpd = ThreadingHTTPServer(("", PORT), H)
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(self.cert, self.key)
        httpd.daemon_threads = True
        httpd.socket = ctx.wrap_socket(httpd.socket, server_side=True, do_handshake_on_connect=False)
        httpd.serve_forever()

    def run(self):
        if self.qs:
            threading.Thread(target=self.qs_serve, daemon=True).start()
        threading.Thread(target=self.listen, daemon=True).start()
        threading.Thread(target=self.tick, daemon=True).start()
        self.serve()


def unique(p):
    if not p.exists() and not p.with_name(p.name + ".part").exists():
        return p
    stem, suf = p.stem, p.suffix
    for i in range(2, 10000):
        q = p.with_name(f"{stem} ({i}){suf}")
        if not q.exists():
            return q
    return p


def human(b):
    for unit in ("B", "KB", "MB", "GB"):
        if b < 1000 or unit == "GB":
            return f"{b:.0f} {unit}" if unit == "B" else f"{b:.1f} {unit}"
        b /= 1000


def mime(path):
    try:
        return subprocess.run(["file", "-b", "--mime-type", path], capture_output=True, text=True).stdout.strip() or "application/octet-stream"
    except OSError:
        return "application/octet-stream"


# --------------------------------------------------------------------- send ---
def send(dev_id, files):
    try:
        devs = json.loads(DEVICES.read_text()).get("devices", [])
    except (OSError, ValueError):
        devs = []
    d = next((x for x in devs if x["id"] == dev_id or x["alias"] == dev_id), None)
    if not d:
        print("ERROR That device is not nearby any more.", flush=True)
        return 1
    files = [os.path.abspath(f) for f in files if os.path.isfile(f)]
    if not files:
        print("ERROR Nothing to send.", flush=True)
        return 1
    if d.get("protocol") == "quickshare":
        if not quickshare:
            print("ERROR Quick Share isn't installed.", flush=True)
            return 1
        my_id = "".join(secrets.choice(quickshare.ALPHABET) for _ in range(4))
        return quickshare.send(d["ip"], d["port"], files, my_id, alias(), lambda line: print(line, flush=True), mime)
    _, _, fp = tls_files()
    meta = {}
    for f in files:
        fid = uuid.uuid4().hex
        meta[fid] = {"id": fid, "fileName": os.path.basename(f), "size": os.path.getsize(f), "fileType": mime(f)}
    base = f"{d['protocol']}://{d['ip']}:{d['port']}{API}"
    if d["protocol"] == "https" and re.fullmatch(r"[0-9A-Fa-f]{64}", d["id"]) and peer_fingerprint(d["ip"], d["port"]) not in ("", d["id"].upper()):
        print(f"ERROR {d['alias']} didn't answer as itself. Look for it again.", flush=True)
        return 1
    print("WAITING", flush=True)   # the other side has to accept
    try:
        r = post(f"{base}/prepare-upload", {"info": me(fp), "files": meta}, timeout=120)
    except urllib.error.HTTPError as e:
        print("ERROR " + ({403: "They declined.", 409: "They are busy receiving something else.", 429: "Too many requests."}.get(e.code, f"It refused ({e.code}).")), flush=True)
        return 1
    except Exception as e:
        print(f"ERROR Couldn't reach {d['alias']} ({type(e).__name__}).", flush=True)
        return 1
    sid, tokens = r.get("sessionId"), r.get("files") or {}
    total = sum(m["size"] for m in meta.values()) or 1
    sent = 0
    print("PROGRESS 0", flush=True)
    for fid, f in zip(meta, files):
        if fid not in tokens:
            continue   # they already have it
        q = urllib.parse.urlencode({"sessionId": sid, "fileId": fid, "token": tokens[fid]})
        size = meta[fid]["size"]
        conn = None
        try:
            import http.client
            conn = http.client.HTTPSConnection(d["ip"], d["port"], timeout=60, context=unverified()) if d["protocol"] == "https" \
                else http.client.HTTPConnection(d["ip"], d["port"], timeout=60)
            conn.putrequest("POST", f"{API}/upload?{q}")
            conn.putheader("Content-Type", "application/octet-stream")
            conn.putheader("Content-Length", str(size))
            conn.endheaders()
            with open(f, "rb") as fh:
                last = -1
                while True:
                    chunk = fh.read(1 << 18)
                    if not chunk:
                        break
                    conn.send(chunk)
                    sent += len(chunk)
                    pct = int(sent * 100 / total)
                    if pct != last:
                        print(f"PROGRESS {pct}", flush=True)
                        last = pct
            res = conn.getresponse()
            res.read()
            if res.status != 200:
                print(f"ERROR {os.path.basename(f)} wasn't accepted ({res.status}).", flush=True)
                return 1
        except Exception as e:
            print(f"ERROR The transfer stopped ({type(e).__name__}).", flush=True)
            return 1
        finally:
            if conn:
                conn.close()
    print("PROGRESS 100", flush=True)
    print("DONE", flush=True)
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "serve"
    if cmd == "serve":
        Service().run()
    elif cmd == "scan":
        RUN.mkdir(parents=True, exist_ok=True)
        (RUN / "scan").touch()
    elif cmd == "devices":
        print(DEVICES.read_text() if DEVICES.exists() else '{"devices": []}')
    elif cmd == "send" and len(sys.argv) > 3:
        sys.exit(send(sys.argv[2], sys.argv[3:]))
    elif cmd == "receive" and len(sys.argv) > 2:
        c = config()
        want = sys.argv[2]
        if want in ("on", "true", "1"):
            want = c.get("onMode") or "everyone"
        want = want if want in ("everyone", "trusted") else "off"
        c["receive"] = want
        if want != "off":
            c["onMode"] = want
        save_config(c)
        RUN.mkdir(parents=True, exist_ok=True)
        (RUN / "scan").touch()     # the service applies it now
        print("Receiving files from nearby devices: " + {"everyone": "everyone", "trusted": "trusted devices only", "off": "off"}[want])
    elif cmd == "trust":
        c = config()
        if len(sys.argv) > 3 and sys.argv[2] == "remove":
            c["trusted"] = [t for t in c.get("trusted") or [] if t.get("id") != sys.argv[3]]
            save_config(c)
        print(json.dumps(c.get("trusted") or [], indent=1))
    elif cmd == "autoaccept" and len(sys.argv) > 2:
        c = config()
        c["autoAccept"] = sys.argv[2] in ("on", "true", "1")
        save_config(c)
    elif cmd == "name" and len(sys.argv) > 2:
        c = config()
        name = " ".join(sys.argv[2].split())[:60]
        if name:
            c["alias"] = name
        else:
            c.pop("alias", None)
        save_config(c)
        RUN.mkdir(parents=True, exist_ok=True)
        (RUN / "scan").touch()
        print(alias())
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
