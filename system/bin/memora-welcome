#!/usr/bin/env bash
# The welcome window. With --first-run it only appears once.
flag="$HOME/.local/state/memora/welcomed"
if [[ ${1:-} == --first-run ]]; then
  [[ -f $flag ]] && exit 0
  mkdir -p "$(dirname "$flag")"; touch "$flag"
fi
exec uwsm app -- qs -p "${MEMORA_PATH:-/usr/share/memora}/shell/welcome.qml"
