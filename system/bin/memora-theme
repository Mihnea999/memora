#!/usr/bin/env bash
# memora-theme — render a theme into ~/.config and reload the desktop.
set -euo pipefail
MEMORA_PATH="${MEMORA_PATH:-/usr/share/memora}"
source "$MEMORA_PATH/lib/render.sh"
themes="$MEMORA_PATH/themes"
state="$HOME/.config/memora/theme"

current() { cat "$state" 2>/dev/null || echo dark; }

# The system typeface (System Settings > Appearance), kept in ~/.config/memora/font
# for everything outside the shell: GTK apps and the title bars Memora draws.
fontfile="$HOME/.config/memora/font"
font_now() {
  local f=""
  [[ -r $fontfile ]] && IFS= read -r f < "$fontfile" || true
  [[ $f =~ ^[[:alnum:]][[:alnum:]\ ._-]{0,63}$ ]] || f="Inter"
  printf '%s' "$f"
}
font_apply() {
  local f; f="$(font_now)"
  for ini in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
    [[ -f $ini ]] && sed -i "s/^gtk-font-name=.*/gtk-font-name=$f 10/" "$ini"
  done
  command -v gsettings >/dev/null && gsettings set org.gnome.desktop.interface font-name "$f 10" 2>/dev/null || true
}
font_set() {
  [[ $1 =~ ^[[:alnum:]][[:alnum:]\ ._-]{0,63}$ ]] || { echo "Not a font name: $1" >&2; exit 1; }
  mkdir -p "$(dirname "$fontfile")"
  printf '%s\n' "$1" > "$fontfile"
  font_apply
}
list() { for d in "$themes"/*/; do basename "$d"; done; }

# The login screen runs as its own user (greeter) and can't read your home: it
# shows your desktop picture and light or dark from /var/lib/memora/look/$USER,
# a folder of yours in a shared one (made by the installer and by updates, sticky
# like /tmp: nobody can touch another's). The shell calls this whenever the
# picture or the appearance changes. The login screen trusts the folder only
# when it belongs to the person it is named after.
looks="${MEMORA_LOOKS:-/var/lib/memora/look}"
login_sync() { # [PICTURE]
  local dir="$looks/${USER:-$(id -un)}" wall="${1:-}" mode tmp
  [[ -d $looks && -w $looks && -k $looks ]] || return 0
  [[ -e $dir ]] || mkdir -m 755 "$dir" 2>/dev/null || return 0
  [[ -d $dir && ! -L $dir && -O $dir ]] || return 0
  chmod 755 "$dir"
  mode="$(current)"; [[ $mode == light ]] || mode=dark
  tmp="$(mktemp "$dir/.theme.XXXXXX")" && printf '%s\n' "$mode" > "$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$dir/theme"
  if [[ -n $wall && -f $wall && -r $wall ]]; then
    # Only when it changed: a picture is big, the appearance switch is not.
    local src; src="$(realpath -e -- "$wall")" || return 0
    [[ "$(cat "$dir/source" 2>/dev/null)" == "$src $(stat -c %Y -- "$src")" && -f $dir/wallpaper ]] && return 0
    tmp="$(mktemp "$dir/.wallpaper.XXXXXX")" || return 0
    # A screen-sized copy (pictures can be 8K); the first frame of a moving one.
    if ! { command -v magick >/dev/null && magick "$src[0]" -auto-orient -resize '3840x3840>' -quality 92 "jpg:$tmp" 2>/dev/null; }; then
      cp -f -- "$src" "$tmp" || { rm -f "$tmp"; return 0; }
    fi
    chmod 644 "$tmp" && mv -f "$tmp" "$dir/wallpaper"
    (umask 077; printf '%s %s\n' "$src" "$(stat -c %Y -- "$src")" > "$dir/source")
    "${MEMORA_PATH:-/usr/share/memora}/bin/memora-login-frame" pre-cache "${USER:-$(id -un)}" "$dir/wallpaper" 2>/dev/null || true
  fi
}

apply() {
  local t="$1" dir="$themes/$1"
  [[ -f $dir/colors ]] || { echo "Unknown theme: $t (try: $(list | tr '\n' ' '))" >&2; exit 1; }
  mkdir -p "$HOME/.config/memora/current"
  echo "$t" > "$state"
  (cd "$MEMORA_PATH/templates" && find . -type f) | while read -r rel; do
    memora_render "$dir/colors" "$MEMORA_PATH/templates/$rel" "$HOME/.config/${rel#./}"
  done
  ln -sfn "$dir/wallpaper.jpg" "$HOME/.config/memora/current/wallpaper.jpg"
  ln -sfn "$dir/logo.png" "$HOME/.config/memora/current/logo.png"
  font_apply   # the templates carry the default typeface

  # shellcheck disable=SC1091
  source "$dir/colors"
  desktop_settings "$dir"
  reload
}

# GTK/libadwaita settings live in dconf, which needs the session bus:
# applied on every login too (autostart), not only when switching themes.
desktop_settings() {
  local dir="${1:-$themes/$(current)}"
  # shellcheck disable=SC1091
  source "$dir/colors"
  if command -v gsettings >/dev/null; then
    local gs="gsettings set org.gnome.desktop.interface"
    $gs color-scheme "$scheme" 2>/dev/null || true
    $gs gtk-theme "$gtk" 2>/dev/null || true
    $gs icon-theme "$icons" 2>/dev/null || true
    $gs font-name "$(font_now) 10" 2>/dev/null || true
    $gs monospace-font-name "JetBrainsMono Nerd Font 10" 2>/dev/null || true
    $gs cursor-theme Adwaita 2>/dev/null || true
    gsettings set org.gnome.desktop.wm.preferences button-layout "close,minimize,maximize:" 2>/dev/null || true
    gsettings set org.gnome.Ptyxis use-system-font true 2>/dev/null || true
    gsettings set org.gnome.Ptyxis restore-session false 2>/dev/null || true
  fi
}

reload() {
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || return 0
  # The shell and Memora apps watch ~/.config/memora/theme and restyle themselves.
  hyprctl reload config-only >/dev/null 2>&1 || true
}

case "${1:-current}" in
  list) list ;;
  desktop-settings) desktop_settings ;;
  current) current ;;
  login-sync) login_sync "${2:-}" ;;
  font) if [[ -n ${2:-} ]]; then font_set "$2"; else font_now; echo; fi ;;
  set) apply "${2:?usage: memora-theme set NAME}" ;;
  next)
    mapfile -t all < <(list)
    cur="$(current)"; next="${all[0]}"
    for i in "${!all[@]}"; do [[ ${all[$i]} == "$cur" ]] && next="${all[$(((i + 1) % ${#all[@]}))]}"; done
    apply "$next"
    ;;

  *) echo "usage: memora-theme [list|current|set NAME|next|font [NAME]|login-sync [PICTURE]]"; exit 1 ;;
esac
