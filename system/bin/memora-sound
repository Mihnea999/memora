#!/usr/bin/env bash
# memora-sound NAME — plays a Memora sound, if System Settings > Sound allows it.
#   alert        the alert sound chosen in Sound (notifications, reminders)
#   startup      when the desktop starts           ("Play sound on startup")
#   volume       after changing the volume          ("Play feedback when volume is changed")
#   screenshot, trash, power, error, done           ("Play user interface sound effects")
#   preview NAME plays an alert sound (glint, drop, …) whatever the settings
# The files are in $MEMORA_PATH/sounds (made by tools/sounds.py).
dir="${MEMORA_PATH:-/usr/share/memora}/sounds"
prefs="$HOME/.config/memora/shell.json"

# Settings, with their defaults when missing or unreadable. "|" separates them
# (with tabs, an empty value would shift the ones after it).
alert=glint vol=0.7 startup=true ui=true feedback=true
if [[ -r $prefs ]]; then
  IFS='|' read -r a v s u f < <(jq -r '[(.alertSound // "glint" | tostring), (.alertVolume // 0.7 | tostring),
    (if has("startupSound") then .startupSound else true end | tostring),
    (if has("uiSounds") then .uiSounds else true end | tostring),
    (if has("volumeFeedback") then .volumeFeedback else true end | tostring)] | join("|")' "$prefs" 2>/dev/null)
  [[ $a =~ ^[a-z0-9-]+$ ]] && alert=$a
  [[ $v =~ ^[0-9]*\.?[0-9]+$ ]] && vol=$v
  [[ $s == false ]] && startup=false
  [[ $u == false ]] && ui=false
  [[ $f == false ]] && feedback=false
fi
# A volume above 1 would be louder than the sound itself: keep it in 0…1.
vol=$(LC_ALL=C awk -v v="$vol" 'BEGIN { if (v > 1) v = 1; if (v < 0) v = 0; printf "%.2f", v }')

play() {
  local file="$dir/$1.oga"
  [[ -f $file ]] || return 0
  # LC_ALL=C: pw-play reads "0.70" by the locale, and in Romanian (decimal comma)
  # it would be 0, silent.
  LC_ALL=C exec pw-play --volume "$2" "$file" 2>/dev/null
}
alert_file() { [[ -f $dir/alert-$1.oga ]] && echo "alert-$1" || echo alert-glint; }

case "${1:-}" in
  alert) play "$(alert_file "$alert")" "$vol" ;;
  preview) n="${2:-$alert}"; [[ $n =~ ^[a-z0-9-]+$ ]] || n=$alert; play "$(alert_file "$n")" "$vol" ;;
  startup)
    [[ $startup == true ]] || exit 0
    # Right after login the sound server may still be finding the speakers:
    # wait (up to 10 s) for an output, so the chord isn't lost.
    for _ in $(seq 50); do wpctl inspect @DEFAULT_AUDIO_SINK@ &>/dev/null && break; sleep 0.2; done
    play startup 0.8 ;;
  volume) [[ $feedback == true ]] && play volume 1 ;;
  screenshot|trash|power|error|done) [[ $ui == true ]] && play "$1" "$vol" ;;
  *) sed -n '2,8p' "$0"; exit 2 ;;
esac
exit 0
