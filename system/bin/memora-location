#!/usr/bin/env bash
# memora-location — roughly where this computer is, from its internet address:
# {"latitude":…,"longitude":…,"city":"…","country":"RO"}. Kept for a day in
# ~/.cache/memora/location.json; asks a second or third service when one is busy
# (they limit how often they answer). Used by the weather widget, and by widgets
# Memora AI makes (air quality, sunrise…).
f="${XDG_CACHE_HOME:-$HOME/.cache}/memora/location.json"
if [[ -s $f && -z $(find "$f" -mmin +1440 2>/dev/null) && ${1:-} != --fresh ]]; then cat "$f"; exit 0; fi
mkdir -p "$(dirname "$f")"
j=""
r=$(curl -sf --max-time 6 https://ipapi.co/json/) && j=$(jq -ce 'select(.latitude != null) | {latitude, longitude, city, country: .country_code}' <<<"$r" 2>/dev/null)
[[ -z $j ]] && r=$(curl -sf --max-time 6 https://ipinfo.io/json) && j=$(jq -ce 'select(.loc != null) | (.loc | split(",")) as $l | {latitude: ($l[0] | tonumber), longitude: ($l[1] | tonumber), city, country}' <<<"$r" 2>/dev/null)
[[ -z $j ]] && r=$(curl -sf --max-time 6 "http://ip-api.com/json/?fields=lat,lon,city,countryCode") && j=$(jq -ce 'select(.lat != null) | {latitude: .lat, longitude: .lon, city, country: .countryCode}' <<<"$r" 2>/dev/null)
if [[ -n $j ]]; then printf '%s\n' "$j" > "$f"; printf '%s\n' "$j"; exit 0; fi
# Offline or all busy: the last one known, however old.
[[ -s $f ]] && { cat "$f"; exit 0; }
exit 1
