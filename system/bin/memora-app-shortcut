#!/usr/bin/env python3
"""
memora-app-shortcut: Management utility for application shortcuts, desktop launchers,
and aliases in Memora OS.
"""

import sys
import os
import stat
import argparse
import json
import re
import subprocess
import shutil
import shlex

HOME = os.path.expanduser("~")
DESKTOP_DIR = os.environ.get("MEMORA_DESKTOP_DIR", os.path.join(HOME, "Desktop"))
APPS_DIR = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local", "share")), "applications")


def slugify(text):
    text = text.lower().strip()
    text = re.sub(r"[^\w\s-]", "", text)
    text = re.sub(r"[\s_-]+", "-", text)
    text = re.sub(r"^-+|-+$", "", text)
    return text or "custom-app"


def find_icon_in_dir(directory):
    if not os.path.isdir(directory):
        return None
    candidates = [
        "icon.png", "icon.svg", "logo.png", "logo.svg", "game.png", "game.svg",
        "app.png", "app.svg", "banner.png", "cover.png", "splash.png"
    ]
    for c in candidates:
        p = os.path.join(directory, c)
        if os.path.isfile(p):
            return p
    # Search top-level for any png/svg
    try:
        for f in os.listdir(directory):
            if f.lower().endswith((".png", ".svg")):
                return os.path.join(directory, f)
    except Exception:
        pass
    return None


def inspect_path(path):
    path = os.path.abspath(os.path.expanduser(path))
    if not os.path.exists(path):
        return {"error": "Path does not exist", "path": path}

    is_dir = os.path.isdir(path)
    is_symlink = os.path.islink(path)
    symlink_target = os.path.realpath(path) if is_symlink else ""

    result = {
        "path": path,
        "isDir": is_dir,
        "isSymlink": is_symlink,
        "symlinkTarget": symlink_target,
        "name": "",
        "exec": "",
        "dir": "",
        "icon": "",
        "category": "Utility",
        "isGame": False,
        "isExecutable": False,
        "isDesktop": path.endswith(".desktop")
    }

    # If it's a .desktop file, parse it
    if path.endswith(".desktop") and os.path.isfile(path):
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                content = f.read()
            for line in content.splitlines():
                if line.startswith("Name=") and not result["name"]:
                    result["name"] = line[5:].strip()
                elif line.startswith("Exec=") and not result["exec"]:
                    result["exec"] = line[5:].strip()
                elif line.startswith("Path=") and not result["dir"]:
                    result["dir"] = line[5:].strip()
                elif line.startswith("Icon=") and not result["icon"]:
                    result["icon"] = line[5:].strip()
                elif line.startswith("Categories="):
                    cats = line[11:].strip()
                    if "Game" in cats:
                        result["category"] = "Game"
                        result["isGame"] = True
            return result
        except Exception:
            pass

    base_name = os.path.basename(path)
    clean_name = os.path.splitext(base_name)[0].replace("-", " ").replace("_", " ").title()
    result["name"] = clean_name

    # Determine if it's a Windows executable or game directory
    lower_path = path.lower()
    if lower_path.endswith((".exe", ".bat", ".cmd")):
        try:
            proton_bin = shutil.which("memora-proton") or os.path.join(os.path.dirname(__file__), "memora-proton")
            if os.path.exists(proton_bin):
                res = subprocess.run([proton_bin, "inspect", path], capture_output=True, text=True)
                if res.returncode == 0:
                    return json.loads(res.stdout)
        except Exception:
            pass

    # Determine if it looks like a game
    if any(k in lower_path for k in ["game", "steam", "itch", "gog", "heroic", "lutris", "roms", "emul"]):
        result["category"] = "Game"
        result["isGame"] = True

    if is_dir:
        result["dir"] = path
        # Look for executable inside folder
        exec_candidates = [
            "start.sh", "run.sh", "launch.sh", "play.sh",
            f"{base_name.lower()}.sh", f"{base_name.lower()}.x86_64", f"{base_name.lower()}.bin",
            f"{base_name.lower()}", "game.x86_64", "game.bin", "game.sh", "main.x86_64"
        ]
        found_exec = None
        for c in exec_candidates:
            p = os.path.join(path, c)
            if os.path.isfile(p):
                found_exec = p
                break
        if not found_exec:
            # Check for Windows game in directory
            try:
                for f in sorted(os.listdir(path)):
                    if f.lower().endswith(".exe") and not f.lower().startswith("unins"):
                        proton_bin = shutil.which("memora-proton") or os.path.join(os.path.dirname(__file__), "memora-proton")
                        if os.path.exists(proton_bin):
                            res = subprocess.run([proton_bin, "inspect", path], capture_output=True, text=True)
                            if res.returncode == 0:
                                return json.loads(res.stdout)
                        break
            except Exception:
                pass

            # Look for any executable file
            try:
                for f in sorted(os.listdir(path)):
                    p = os.path.join(path, f)
                    if os.path.isfile(p) and (os.access(p, os.X_OK) or f.endswith((".x86_64", ".AppImage", ".bin", ".sh"))):
                        found_exec = p
                        break
            except Exception:
                pass

        if found_exec:
            result["exec"] = found_exec
            result["isExecutable"] = True
        else:
            result["exec"] = path

        result["icon"] = find_icon_in_dir(path) or ("gamepad" if result["isGame"] else "folder")
    else:
        result["exec"] = path
        result["dir"] = os.path.dirname(path)
        is_exec = os.access(path, os.X_OK) or path.endswith((".AppImage", ".sh", ".bin", ".x86_64", ".py"))
        result["isExecutable"] = is_exec
        result["icon"] = find_icon_in_dir(result["dir"]) or ("gamepad" if result["isGame"] else "application-x-executable")

    return result


def create_shortcut(args):
    os.makedirs(APPS_DIR, exist_ok=True)
    os.makedirs(DESKTOP_DIR, exist_ok=True)

    name = args.name.strip()
    if not name:
        name = "Custom App"

    exec_path = os.path.abspath(os.path.expanduser(args.exec))
    work_dir = os.path.abspath(os.path.expanduser(args.dir)) if args.dir else os.path.dirname(exec_path)

    # Ensure executable bit is set
    if os.path.exists(exec_path):
        try:
            mode = os.stat(exec_path).st_mode
            os.chmod(exec_path, mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
        except Exception:
            pass

    icon = args.icon
    if not icon:
        detected = find_icon_in_dir(work_dir)
        if detected:
            icon = detected
        elif args.category == "Game":
            icon = "gamepad"
        else:
            icon = "application-x-executable"

    category = args.category or "Utility"
    if not category.endswith(";"):
        category += ";"

    terminal_val = "true" if args.terminal else "false"

    exec_cmd = exec_path
    if exec_path.lower().endswith((".exe", ".bat", ".cmd")):
        exec_cmd = f"memora-proton run {shlex.quote(exec_path)}"

    desktop_content = f"""[Desktop Entry]
Type=Application
Name={name}
Exec={exec_cmd}
Path={work_dir}
Icon={icon}
Terminal={terminal_val}
Categories={category}
StartupNotify=true
"""

    slug = slugify(name)
    app_desktop_path = os.path.join(APPS_DIR, f"{slug}.desktop")
    desktop_shortcut_path = os.path.join(DESKTOP_DIR, f"{name}.desktop")

    created = []

    # Install to applications list if requested (or default)
    if args.app or (not args.app and not args.desktop):
        with open(app_desktop_path, "w", encoding="utf-8") as f:
            f.write(desktop_content)
        os.chmod(app_desktop_path, 0o755)
        created.append(app_desktop_path)
        subprocess.run(["update-desktop-database", APPS_DIR], capture_output=True)

    # Create desktop shortcut if requested
    if args.desktop:
        with open(desktop_shortcut_path, "w", encoding="utf-8") as f:
            f.write(desktop_content)
        os.chmod(desktop_shortcut_path, 0o755)
        created.append(desktop_shortcut_path)

    # Play pop sound if available
    try:
        subprocess.Popen(["memora-sound", "pop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    print(json.dumps({"success": True, "created": created, "name": name, "exec": exec_path}))


def make_alias(args):
    target = os.path.abspath(os.path.expanduser(args.target))
    if not os.path.exists(target):
        print(json.dumps({"error": f"Target path {target} does not exist"}))
        sys.exit(1)

    dest_dir = os.path.abspath(os.path.expanduser(args.dest)) if args.dest else DESKTOP_DIR
    os.makedirs(dest_dir, exist_ok=True)

    base = os.path.basename(target)
    # macOS naming convention for aliases
    name, ext = os.path.splitext(base)
    alias_name = f"{name} alias{ext}" if dest_dir == os.path.dirname(target) else base

    # If already exists, add number
    counter = 2
    final_path = os.path.join(dest_dir, alias_name)
    while os.path.lexists(final_path):
        final_path = os.path.join(dest_dir, f"{name} alias {counter}{ext}")
        counter += 1

    try:
        os.symlink(target, final_path)
        try:
            subprocess.Popen(["memora-sound", "pop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        print(json.dumps({"success": True, "alias": final_path, "target": target}))
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)


def launch_path(args):
    path = os.path.abspath(os.path.expanduser(args.path))
    if not os.path.exists(path) and not os.path.islink(path):
        print(json.dumps({"error": f"Path {path} does not exist"}))
        sys.exit(1)

    # Resolve symlinks
    real_path = os.path.realpath(path)

    # If it's a directory -> open in Files
    if os.path.isdir(real_path):
        subprocess.Popen(["memora-files", real_path], start_new_session=True)
        print(json.dumps({"success": True, "launched": "memora-files", "path": real_path}))
        return

    # If it's a .desktop file -> parse and launch
    if path.endswith(".desktop") and os.path.isfile(path):
        exec_cmd = None
        work_dir = None
        terminal = False
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    if line.startswith("Exec=") and exec_cmd is None:
                        exec_cmd = line[5:].strip()
                    elif line.startswith("Path=") and work_dir is None:
                        work_dir = line[5:].strip()
                    elif line.startswith("Terminal="):
                        terminal = line[9:].strip().lower() == "true"
        except Exception:
            pass

        if exec_cmd:
            # Strip field codes (%f, %F, %u, %U, etc.)
            clean_cmd = re.sub(r"%[a-zA-Z]", "", exec_cmd).strip()
            work_dir = work_dir or os.path.dirname(clean_cmd.split()[0])
            if not os.path.isdir(work_dir):
                work_dir = HOME

            if terminal:
                full_cmd = f"cd {shlex.quote(work_dir)} && {clean_cmd}"
                subprocess.Popen(["ghostty", "-e", "bash", "-c", full_cmd], start_new_session=True)
            else:
                full_cmd = f"cd {shlex.quote(work_dir)} && exec {clean_cmd}"
                subprocess.Popen(["bash", "-c", full_cmd], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            print(json.dumps({"success": True, "launched": clean_cmd, "dir": work_dir}))
            return

    # If it's a Windows executable (.exe, .bat, .cmd)
    if real_path.lower().endswith((".exe", ".bat", ".cmd")):
        proton_bin = shutil.which("memora-proton") or os.path.join(os.path.dirname(__file__), "memora-proton")
        subprocess.Popen([proton_bin, "run", real_path], start_new_session=True)
        print(json.dumps({"success": True, "launched": "memora-proton", "path": real_path}))
        return

    # If it's an executable (ELF, script, AppImage)
    if os.access(real_path, os.X_OK) or real_path.endswith((".AppImage", ".sh", ".bin", ".x86_64")):
        try:
            mode = os.stat(real_path).st_mode
            os.chmod(real_path, mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
        except Exception:
            pass
        work_dir = os.path.dirname(real_path)
        subprocess.Popen([real_path], cwd=work_dir, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(json.dumps({"success": True, "launched": real_path, "dir": work_dir}))
        return

    # Fallback to gio open
    subprocess.Popen(["gio", "open", path], start_new_session=True)
    print(json.dumps({"success": True, "launched": "gio open", "path": path}))


def main():
    parser = argparse.ArgumentParser(description="Memora App & Shortcut Manager")
    subparsers = parser.add_subparsers(dest="command")

    # create
    p_create = subparsers.add_parser("create")
    p_create.add_argument("--name", required=True, help="Display name of application/shortcut")
    p_create.add_argument("--exec", required=True, help="Executable path or command")
    p_create.add_argument("--dir", default="", help="Working directory")
    p_create.add_argument("--icon", default="", help="Icon path or theme name")
    p_create.add_argument("--category", default="Game", help="Category: Game, Utility, etc.")
    p_create.add_argument("--terminal", action="store_true", help="Run in terminal")
    p_create.add_argument("--app", action="store_true", help="Add to ~/.local/share/applications/")
    p_create.add_argument("--desktop", action="store_true", help="Add shortcut to ~/Desktop/")

    # alias
    p_alias = subparsers.add_parser("alias")
    p_alias.add_argument("target", help="File or folder to create shortcut to")
    p_alias.add_argument("dest", nargs="?", default="", help="Destination directory (default ~/Desktop)")

    # launch
    p_launch = subparsers.add_parser("launch")
    p_launch.add_argument("path", help="Path to .desktop, executable or shortcut to run")

    # inspect
    p_inspect = subparsers.add_parser("inspect")
    p_inspect.add_argument("path", help="Path to inspect")

    args = parser.parse_args()
    if args.command == "create":
        create_shortcut(args)
    elif args.command == "alias":
        make_alias(args)
    elif args.command == "launch":
        launch_path(args)
    elif args.command == "inspect":
        print(json.dumps(inspect_path(args.path)))
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
