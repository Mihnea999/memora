#!/usr/bin/env python3
"""memora-window — place windows in the free area of their screen (below the
menu bar, above the Dock), remembering how big they were before.

  memora-window ZONE [ADDRESS]    left right top bottom fill center
                                  top-left top-right bottom-left bottom-right
                                  left-third center-third right-third
                                  left-two-thirds right-two-thirds
  memora-window key DIR [ADDRESS] Super+arrow: halves, then two-thirds and
                                  thirds on repeat; combine for quarters
                                  (left then up = top-left); down restores
  memora-window restore [ADDRESS] back to the size it had before docking
  memora-window unsnap ADDRESS X Y  being dragged away: back to its own size,
                                  under the pointer at X Y
  memora-window inside [ADDRESS]  after a drag: a window whose top went under the
                                  menu bar comes back below it (else its title
                                  bar, all you can hold it by, is out of reach)
  memora-window zone [ADDRESS]    print the zone it is docked in, if any
  memora-window rect ZONE         print the zone's rectangle (x y w h)
  memora-window layouts           the layouts that suit the focused window's screen
  memora-window arrange [pair]    arrange the windows of this desktop in a grid that
                                  suits the screen (pair: the active and the previous)
  memora-window refit [MONITOR]   after a screen change: docked windows dock again,
                                  the others shrink to fit and come inside
  memora-window screen DIR [ADDRESS]  to the screen left/right/up/down/next
  memora-window group [ADDRESS]   the windows docked together with it
Zones are in default/zones.json (shared with the shell), or frac:FX,FY,FW,FH.
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

GAP = int(os.environ.get("MEMORA_GAP", "10"))
SHARE = Path(os.environ.get("MEMORA_PATH", "/usr/share/memora"))
STATE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "memora" / "windows.json"


def hypr(*args):
    out = subprocess.run(["hyprctl", "-j", *args], capture_output=True, text=True).stdout
    return json.loads(out or "null")


def dispatch(expr):
    subprocess.run(["hyprctl", "dispatch", expr], capture_output=True)


def load():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def save(s):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    # Forget windows that are gone.
    alive = {c["address"] for c in hypr("clients") or []}
    STATE.write_text(json.dumps({k: v for k, v in s.items() if k in alive}))


def window(addr=None):
    if addr:
        a = addr if addr.startswith("0x") else "0x" + addr
        return next((c for c in hypr("clients") or [] if c["address"] == a), None)
    w = hypr("activewindow")
    return w if w and w.get("address") else None


def area(w):
    ms = hypr("monitors")
    m = next((m for m in ms if m["id"] == w["monitor"]), None) or next(m for m in ms if m["focused"])
    s = m["scale"]
    l, t, r, b = m["reserved"]
    mw, mh = int(m["width"] / s), int(m["height"] / s)
    if m["transform"] in (1, 3, 5, 7):
        mw, mh = mh, mw
    return (m["x"] + l + GAP, m["y"] + t + GAP, mw - l - r - 2 * GAP, mh - t - b - 2 * GAP)


def title_bar(w):
    """Height of the title bar Memora draws above this window (apps that leave
    their frame to the system, see plugin/titlebar.cpp), else 0."""
    try:
        run = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        for line in open(os.path.join(run, "memora-titlebars")):
            addr, _, h = line.partition(" ")
            if addr == w["address"]:
                return int(h)
    except (OSError, ValueError, KeyError):
        pass
    return 0


_ZONES = None


def zones():
    """Zone fractions and layouts, shared with the shell (default/zones.json)."""
    global _ZONES
    if _ZONES is None:
        try:
            _ZONES = json.loads((SHARE / "default" / "zones.json").read_text())
        except (OSError, ValueError):
            _ZONES = {"zones": {"fill": [0, 0, 1, 1], "left": [0, 0, 0.5, 1], "right": [0.5, 0, 0.5, 1]}, "layouts": {}}
    return _ZONES


def fractions(zone):
    """[fx, fy, fw, fh] for a named zone, or for "frac:fx,fy,fw,fh" (Arrange's grids)."""
    if zone and zone.startswith("frac:"):
        try:
            f = [float(v) for v in zone[5:].split(",")]
            return f if len(f) == 4 else None
        except ValueError:
            return None
    return zones()["zones"].get(zone)


def kind(a):
    """What shape of screen the free area is: compact, wide, portrait or regular."""
    _, _, aw, ah = a
    if ah > aw:
        return "portrait"
    if aw / max(1, ah) >= 2.1:
        return "wide"
    if aw < 1400:
        return "compact"
    return "regular"


def min_size(w):
    """The smallest size the app accepts (from the Memora plugin), else 1x1."""
    try:
        out = subprocess.run(["hyprctl", "memora-sizes"], capture_output=True, text=True, timeout=2).stdout
        for e in json.loads(out or "[]"):
            if e.get("address") == w["address"]:
                return tuple(e.get("min") or (1, 1))
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    return (1, 1)


def fits(zone, w, a, mn=None):
    r = rect(zone, a, w)
    mn = mn or min_size(w)
    return bool(r) and r[2] + 2 >= mn[0] and r[3] + 2 >= mn[1]


def rect(zone, a, w=None):
    ax, ay, aw, ah = a
    if w:   # leave room for a title bar drawn above the window
        bar = title_bar(w)
        ay, ah = ay + bar, ah - bar
    f = fractions(zone)
    if f:
        fx, fy, fw, fh = f
        x0, y0 = round(ax + fx * (aw + GAP)), round(ay + fy * (ah + GAP))
        x1, y1 = round(ax + (fx + fw) * (aw + GAP) - GAP), round(ay + (fy + fh) * (ah + GAP) - GAP)
        return (x0, y0, x1 - x0, y1 - y0)
    if zone == "center" and w:
        ww, wh = min(w["size"][0], aw), min(w["size"][1], ah)
        return (ax + (aw - ww) // 2, ay + (ah - wh) // 2, ww, wh)
    return None


def current_zone(w, a, st):
    """The zone the window sits in now (it may have been moved by hand since)."""
    z = st.get(w["address"], {}).get("zone")
    if not z:
        return None
    r = rect(z, a, w)
    x, y = w["at"]
    ww, wh = w["size"]
    if r and abs(r[0] - x) <= 6 and abs(r[1] - y) <= 6 and abs(r[2] - ww) <= 6 and abs(r[3] - wh) <= 6:
        return z
    return None


def place(w, zone, st, a=None):
    a = a or area(w)
    r = rect(zone, a, w)
    if not r:
        return
    sel = f'window = "address:{w["address"]}"'
    rec = st.setdefault(w["address"], {})
    # Remember its own size the first time it docks.
    if not current_zone(w, a, st) and zone != "center":
        rec["orig"] = [*w["at"], *w["size"]]
    if not w["floating"]:
        dispatch(f'hl.dsp.window.float({{ action = "enable", {sel} }})')
    dispatch(f'hl.dsp.window.resize({{ x = {r[2]}, y = {r[3]}, {sel} }})')
    dispatch(f'hl.dsp.window.move({{ x = {r[0]}, y = {r[1]}, {sel} }})')
    rec["zone"] = zone if zone != "center" else None


def restore(w, st, at=None):
    rec = st.get(w["address"], {})
    o = rec.get("orig")
    a = area(w)
    sel = f'window = "address:{w["address"]}"'
    if o:
        ww, wh = min(o[2], a[2]), min(o[3], a[3])
        if at:   # under the pointer, keeping it at the same spot across the title bar
            fx = (at[0] - w["at"][0]) / max(1, w["size"][0])
            x, y = int(at[0] - fx * ww), int(at[1] - min(24, at[1] - w["at"][1]))
        else:
            x, y = o[0], o[1]
        dispatch(f'hl.dsp.window.resize({{ x = {ww}, y = {wh}, {sel} }})')
        dispatch(f'hl.dsp.window.move({{ x = {x}, y = {y}, {sel} }})')
    elif not at:
        place(w, "center", st, a)
    rec.pop("zone", None)
    rec.pop("orig", None)
    rec.pop("group", None)   # it leaves its group of docked windows


def monitors():
    return hypr("monitors") or []


def area_of(m):
    s = m["scale"]
    l, t, r, b = m["reserved"]
    mw, mh = int(m["width"] / s), int(m["height"] / s)
    if m["transform"] in (1, 3, 5, 7):
        mw, mh = mh, mw
    return (m["x"] + l + GAP, m["y"] + t + GAP, mw - l - r - 2 * GAP, mh - t - b - 2 * GAP)


def shown_on(m):
    """Windows showing on a monitor's desktop that docking may move, most recent first."""
    ws = (m.get("activeWorkspace") or {}).get("id")
    out = [c for c in hypr("clients") or [] if c.get("mapped", True) and not c.get("hidden") and c["monitor"] == m["id"]
           and (c.get("workspace") or {}).get("id") == ws and c.get("floating") and not c.get("fullscreen") and not c.get("pinned")]
    return sorted(out, key=lambda c: c.get("focusHistoryID", 99))


def grid(cols, rows, n):
    """n cells, row by row; a last row with fewer windows shares its width."""
    cells = []
    for i in range(n):
        r, c = divmod(i, cols)
        in_row = min(cols, n - r * cols)
        cells.append(f"frac:{c / in_row:.6f},{r / rows:.6f},{1 / in_row:.6f},{1 / rows:.6f}")
    return cells


def arrangement(n, k):
    """Where n windows go on a screen of kind k (compact, regular, wide, portrait)."""
    if n == 1:
        return ["fill"]
    if k == "portrait":
        return {2: ["top", "bottom"], 3: ["top-third", "middle-third", "bottom-third"]}.get(n) or grid(2, (n + 1) // 2, n)
    if k == "wide":
        return {2: ["left", "right"], 3: ["left-third", "center-third", "right-third"],
                4: ["first-fourth", "second-fourth", "third-fourth", "last-fourth"]}.get(n) or grid(4 if n > 6 else 3, 2 if n <= 8 else 3, n)
    return {2: ["left", "right"], 3: ["left", "top-right", "bottom-right"],
            4: ["top-left", "top-right", "bottom-left", "bottom-right"]}.get(n) or grid(3, 2 if n <= 6 else 3, n)


def arrange(st, pair=False):
    """Arrange the windows of the focused screen's desktop; the active one first.
    Windows docked together form a group (the shell brings them forward together)."""
    m = next((m for m in monitors() if m["focused"]), None)
    if not m:
        return
    a = area_of(m)
    wins = shown_on(m)[:2 if pair else 9]
    if not wins:
        return
    try:
        sizes = {e["address"]: e.get("min") or (1, 1) for e in json.loads(subprocess.run(["hyprctl", "memora-sizes"], capture_output=True, text=True, timeout=2).stdout or "[]")}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        sizes = {}
    # Fewer windows when some can't shrink to their part.
    while wins:
        zs = arrangement(len(wins), kind(a))
        bad = [i for i, w in enumerate(wins) if not fits(zs[i], w, a, sizes.get(w["address"], (1, 1)))]
        if not bad:
            break
        wins.pop(bad[-1])
    gid = str(int(time.time() * 1000)) if len(wins) > 1 else None
    for w, z in zip(wins, arrangement(len(wins), kind(a))):
        place(w, z, st, a)
        if gid:
            st[w["address"]]["group"] = gid


def overlap(r1, r2):
    return r1[0] < r2[0] + r2[2] and r2[0] < r1[0] + r1[2] and r1[1] < r2[1] + r2[3] and r2[1] < r1[1] + r1[3]


def join_group(w, zone, st):
    """A window docked beside others (Snap Assist, the layouts bar, Super+arrows)
    joins them: windows docked side by side on a desktop come forward together."""
    a = area(w)
    mine = rect(zone, a, w)
    ws = (w.get("workspace") or {}).get("id")
    mates = [c for c in hypr("clients") or [] if c["address"] != w["address"] and c["monitor"] == w["monitor"]
             and (c.get("workspace") or {}).get("id") == ws and current_zone(c, a, st)]
    mates = [c for c in mates if not overlap(rect(st[c["address"]]["zone"], a, c), mine)]
    if not mates:
        st[w["address"]].pop("group", None)
        return
    gid = next((st[c["address"]].get("group") for c in mates if st[c["address"]].get("group")), None) or str(int(time.time() * 1000))
    for c in mates + [w]:
        st.setdefault(c["address"], {})["group"] = gid


def refit(st, only=None):
    """After a screen changed (scale, resolution, plugged in or out, the Dock
    moved): docked windows dock again in their zone; the others shrink to fit and
    come inside the free area."""
    ms = {m["id"]: m for m in monitors()}
    for c in hypr("clients") or []:
        m = ms.get(c["monitor"])
        if not m or (only and m["name"] != only) or not c.get("floating") or c.get("fullscreen") or (c.get("workspace") or {}).get("name", "").startswith("special"):
            continue
        a = area_of(m)
        z = st.get(c["address"], {}).get("zone")
        if z and fractions(z):
            place(c, z, st, a)
            continue
        x, y = c["at"]
        ww, wh = c["size"]
        nw, nh = min(ww, a[2]), min(wh, a[3])
        nx = min(max(x, a[0]), a[0] + a[2] - nw)
        ny = min(max(y, a[1]), a[1] + a[3] - nh)
        sel = f'window = "address:{c["address"]}"'
        if (nw, nh) != (ww, wh):
            dispatch(f'hl.dsp.window.resize({{ x = {nw}, y = {nh}, {sel} }})')
        if (nx, ny) != (x, y):
            dispatch(f'hl.dsp.window.move({{ x = {nx}, y = {ny}, {sel} }})')


def to_screen(w, direction, st):
    """Move a window to the screen in a direction (or the next one), keeping its
    zone, or its place and size relative to the screen."""
    ms = monitors()
    cur = next((m for m in ms if m["id"] == w["monitor"]), None)
    if not cur or len(ms) < 2:
        return
    ca = area_of(cur)
    cx, cy = ca[0] + ca[2] / 2, ca[1] + ca[3] / 2

    def score(m):
        a = area_of(m)
        dx, dy = a[0] + a[2] / 2 - cx, a[1] + a[3] / 2 - cy
        ok = {"left": dx < -1 and abs(dx) >= abs(dy), "right": dx > 1 and abs(dx) >= abs(dy),
              "up": dy < -1 and abs(dy) > abs(dx), "down": dy > 1 and abs(dy) > abs(dx)}.get(direction, True)
        return abs(dx) + abs(dy) if ok else None
    named = next((m for m in ms if m["name"] == direction), None)
    if named:
        others = [(0, 0, named)] if named["id"] != cur["id"] else []
        direction = "named"
    else:
        others = sorted(((score(m), i, m) for i, m in enumerate(ms) if m["id"] != cur["id"] and score(m) is not None), key=lambda t: (t[0], t[1]))
    if not others:
        return
    if direction == "next":   # the next one along, round
        order = sorted(ms, key=lambda m: (m["x"], m["y"]))
        tgt = order[(order.index(cur) + 1) % len(order)]
    else:
        tgt = others[0][2]
    ta = area_of(tgt)
    z = current_zone(w, ca, st)
    if z:
        place(w, z, st, ta)
        return
    fx, fy = (w["at"][0] - ca[0]) / max(1, ca[2]), (w["at"][1] - ca[1]) / max(1, ca[3])
    nw, nh = min(w["size"][0], ta[2]), min(w["size"][1], ta[3])
    nx = int(min(ta[0] + fx * ta[2], ta[0] + ta[2] - nw))
    ny = int(min(ta[1] + fy * ta[3], ta[1] + ta[3] - nh))
    sel = f'window = "address:{w["address"]}"'
    dispatch(f'hl.dsp.window.move({{ x = {nx}, y = {ny}, {sel} }})')
    if (nw, nh) != tuple(w["size"]):
        dispatch(f'hl.dsp.window.resize({{ x = {nw}, y = {nh}, {sel} }})')
        dispatch(f'hl.dsp.window.move({{ x = {nx}, y = {ny}, {sel} }})')


# Super+arrows: what each key does from where the window is now.
KEYS = {
    "left": {None: "left", "left": "left-two-thirds", "left-two-thirds": "left-third", "left-third": "left",
             "right": "left", "top-right": "top-left", "bottom-right": "bottom-left", "top-left": "left",
             "bottom-left": "left", "right-two-thirds": "left", "right-third": "left-third", "center-third": "left-third",
             "fill": "left", "top": "top-left", "bottom": "bottom-left"},
    "right": {None: "right", "right": "right-two-thirds", "right-two-thirds": "right-third", "right-third": "right",
              "left": "right", "top-left": "top-right", "bottom-left": "bottom-right", "top-right": "right",
              "bottom-right": "right", "left-two-thirds": "right", "left-third": "right-third", "center-third": "right-third",
              "fill": "right", "top": "top-right", "bottom": "bottom-right"},
    "up": {None: "fill", "left": "top-left", "right": "top-right", "bottom-left": "left", "bottom-right": "right",
           "bottom": "fill", "top-left": "top-left", "top-right": "top-right", "fill": "fill", "top": "fill",
           "left-third": "fill", "center-third": "fill", "right-third": "fill", "left-two-thirds": "fill", "right-two-thirds": "fill"},
    "down": {"left": "bottom-left", "right": "bottom-right", "top-left": "left", "top-right": "right",
             "top": "fill", "bottom-left": "bottom-left", "bottom-right": "bottom-right"},
}


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        return 1
    cmd = args[0]
    st = load()
    if cmd == "layouts":   # the layouts for the focused window's screen, as JSON
        w = window()
        a = area(w) if w else (0, 0, 1920, 1080)
        print(json.dumps({"kind": kind(a), "layouts": zones()["layouts"].get(kind(a), [])}))
        return 0
    if cmd == "rect":
        w = window()
        r = rect(args[1], area(w), w) if w else None
        if r:
            print(*r)
        return 0
    if cmd == "key":
        w = window(args[2] if len(args) > 2 else None)
        if not w or w.get("fullscreen"):
            return 0
        a = area(w)
        z = current_zone(w, a, st)
        nxt = KEYS.get(args[1], {}).get(z)
        # Skip what the window can't shrink to (a third of a small screen).
        mn = min_size(w)
        seen = set()
        while nxt and not fits(nxt, w, a, mn) and nxt not in seen:
            seen.add(nxt)
            nxt = KEYS.get(args[1], {}).get(nxt)
        if nxt in seen:
            nxt = None
        if args[1] == "down" and nxt is None:
            restore(w, st)
        elif nxt:
            place(w, nxt, st, a)
    elif cmd == "corner":   # Picture in Picture let go: to the nearest corner
        w = window(args[1] if len(args) > 1 else None)
        if w:
            ax, ay, aw, ah = area(w)
            x = ax if w["at"][0] + w["size"][0] / 2 < ax + aw / 2 else ax + aw - w["size"][0]
            y = ay if w["at"][1] + w["size"][1] / 2 < ay + ah / 2 else ay + ah - w["size"][1]
            dispatch(f'hl.dsp.window.move({{ x = {x}, y = {y}, window = "address:{w["address"]}" }})')
        return 0
    elif cmd == "arrange":
        arrange(st, pair=len(args) > 1 and args[1] == "pair")
    elif cmd == "refit":
        refit(st, args[1] if len(args) > 1 else None)
    elif cmd == "screen":
        w = window(args[2] if len(args) > 2 else None)
        if w and not w.get("fullscreen"):
            to_screen(w, args[1] if len(args) > 1 else "next", st)
    elif cmd == "group":   # the addresses docked together with a window
        w = window(args[1] if len(args) > 1 else None)
        g = st.get(w["address"], {}).get("group") if w else None
        a = area(w) if w else None
        alive = {c["address"]: c for c in hypr("clients") or []}
        if g:
            print(" ".join(k for k, v in st.items() if v.get("group") == g and k in alive and current_zone(alive[k], area(alive[k]), st)))
        return 0
    elif cmd == "restore":
        w = window(args[1] if len(args) > 1 else None)
        if w:
            restore(w, st)
    elif cmd == "unsnap":
        w = window(args[1])
        if w and st.get(w["address"], {}).get("orig") and current_zone(w, area(w), st):
            restore(w, st, at=(int(float(args[2])), int(float(args[3]))))
    elif cmd == "inside":
        w = window(args[1] if len(args) > 1 else None)
        if w and w.get("floating") and not w.get("fullscreen"):
            ms = hypr("monitors")
            m = next((m for m in ms if m["id"] == w["monitor"]), None) or next(m for m in ms if m["focused"])
            top = m["y"] + m["reserved"][1]          # just under the menu bar
            y = w["at"][1] - title_bar(w)
            if y < top:
                dispatch(f'hl.dsp.window.move({{ x = {w["at"][0]}, y = {top + title_bar(w) + 4}, window = "address:{w["address"]}" }})')
        return 0
    elif cmd == "zone":
        w = window(args[1] if len(args) > 1 else None)
        print((current_zone(w, area(w), st) or "") if w else "")
        return 0
    else:
        w = window(args[1] if len(args) > 1 else None)
        if not w or w.get("fullscreen"):
            return 0
        if rect(cmd, (0, 0, 100, 100), w) is None and cmd != "center":
            print(__doc__)
            return 1
        place(w, cmd, st)
        if cmd not in ("center", "fill"):
            join_group(w, cmd, st)
    save(st)
    return 0


if __name__ == "__main__":
    sys.exit(main())
