#!/usr/bin/env bash
# memora-screenshot region|screen|edit — saves to ~/Pictures/Screenshots and copies.
set -euo pipefail
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
case "${1:-region}" in
  region) geo="$(slurp -d)" || exit 0; grim -g "$geo" "$file"; memora-sound screenshot & ;;
  screen) grim "$file"; memora-sound screenshot & ;;
  edit) geo="$(slurp -d)" || exit 0; memora-sound screenshot & grim -g "$geo" - | satty --filename - --output-filename "$file" --copy-command wl-copy --early-exit; exit 0 ;;
esac
wl-copy < "$file"
notify-send -a memora -h boolean:suppress-sound:true -i "$file" "Screenshot saved" "${file/#$HOME/\~}"
