#!/usr/bin/env bash
# memora-photos [FILE] — Photos. With Photos open, shows FILE in it.
dir="${MEMORA_PATH:-/usr/share/memora}"
source "$dir/lib/single.sh"
qml="$dir/shell/photos.qml"
f="${1:-}"; f="${f#file://}"
[[ -n $f ]] && f="$(realpath -m "$f")"
if memora_single memora-photos "$qml"; then
  [[ -n $f ]] && qs -p "$qml" ipc call photos open "$f"
  exit 0
fi
MEMORA_PHOTOS_FILE="$f" exec qs -p "$qml"
