#!/usr/bin/env bash
# memora-store-cli — App Store entries that are command-line tools rather than
# Flathub apps (AI coding agents, language toolchains). Each is installed for
# you, from its makers' official channel.
#   memora-store-cli list               ids that are installed
#   memora-store-cli install|remove ID
#   memora-store-cli open ID            start it in Terminal
set -uo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

node_ready() {
  command -v npm >/dev/null && return 0
  mise use -g node@lts >/dev/null 2>&1 && mise reshim >/dev/null 2>&1
  command -v npm >/dev/null
}
uv_ready() { command -v uv >/dev/null || { mise use -g uv@latest >/dev/null 2>&1 && mise reshim >/dev/null 2>&1; }; command -v uv >/dev/null; }
npm_tool() { # install|remove PACKAGE
  node_ready || { echo "Node.js could not be set up."; return 1; }
  if [[ $1 == install ]]; then npm install -g "$2"; else npm uninstall -g "$2"; fi
  mise reshim >/dev/null 2>&1 || true
}

# Claude Desktop: Anthropic ships it as a .deb (Debian/Ubuntu). Memora unpacks
# the newest one from Anthropic's own repository into your home folder.
CD_BASE=https://downloads.claude.ai/claude-desktop/apt/stable
CD_DIR="$HOME/.local/share/memora-apps/claude-desktop"
claude_desktop_install() {
  local f tmp
  f="$(curl -fsS "$CD_BASE/dists/stable/main/binary-amd64/Packages" | grep '^Filename: pool/main/c/claude-desktop/claude-desktop_' | sort -V | tail -n 1 | cut -d' ' -f2)"
  [[ -n $f ]] || { echo "Couldn't find Claude Desktop."; return 1; }
  tmp="$(mktemp -d)"
  curl -fSL --progress-bar -o "$tmp/pkg.deb" "$CD_BASE/$f" 2>&1 | tr '\r' '\n' || { rm -rf "$tmp"; return 1; }
  ( cd "$tmp" && bsdtar -xf pkg.deb && mkdir root && bsdtar -xf data.tar.* -C root ) || { rm -rf "$tmp"; return 1; }
  rm -rf "$CD_DIR"; mkdir -p "$CD_DIR" "$HOME/.local/bin" "$HOME/.local/share/applications"
  cp -a "$tmp/root/usr/lib/claude-desktop/." "$CD_DIR/"
  cp -a "$tmp/root/usr/share/icons/." "$HOME/.local/share/icons/" 2>/dev/null || true
  printf '#!/bin/sh\nexec "%s/claude-desktop" --ozone-platform-hint=auto --password-store=gnome-libsecret "$@"\n' "$CD_DIR" > "$HOME/.local/bin/claude-desktop"
  chmod +x "$HOME/.local/bin/claude-desktop"
  sed "s|^Exec=claude-desktop|Exec=$HOME/.local/bin/claude-desktop|" "$tmp/root/usr/share/applications/com.anthropic.Claude.desktop" \
    > "$HOME/.local/share/applications/com.anthropic.Claude.desktop"
  basename "$f" | sed 's/^claude-desktop_\(.*\)_amd64.deb$/\1/' > "$CD_DIR/.memora-version"
  rm -rf "$tmp"
}
claude_desktop_remove() { rm -rf "$CD_DIR" "$HOME/.local/bin/claude-desktop" "$HOME/.local/share/applications/com.anthropic.Claude.desktop"; }

# id | command it provides | how to install | how to remove
recipe() {
  case "$1" in
    claude-desktop) cmd=claude-desktop; inst() { claude_desktop_install; }; rem() { claude_desktop_remove; } ;;
    claude-code) cmd=claude; inst() { curl -fsSL https://claude.ai/install.sh | bash; }; rem() { rm -f "$HOME/.local/bin/claude"; rm -rf "$HOME/.local/share/claude"; } ;;
    codex) cmd=codex; inst() { npm_tool install @openai/codex; }; rem() { npm_tool remove @openai/codex; } ;;
    gemini-cli) cmd=gemini; inst() { npm_tool install @google/gemini-cli; }; rem() { npm_tool remove @google/gemini-cli; } ;;
    copilot-cli) cmd=copilot; inst() { npm_tool install @github/copilot; }; rem() { npm_tool remove @github/copilot; } ;;
    opencode) cmd=opencode; inst() { npm_tool install opencode-ai; }; rem() { npm_tool remove opencode-ai; } ;;
    qwen-code) cmd=qwen; inst() { npm_tool install @qwen-code/qwen-code; }; rem() { npm_tool remove @qwen-code/qwen-code; } ;;
    crush) cmd=crush; inst() { npm_tool install @charmland/crush; }; rem() { npm_tool remove @charmland/crush; } ;;
    aider) cmd=aider; inst() { uv_ready && uv tool install --python 3.12 aider-chat; }; rem() { uv tool uninstall aider-chat; } ;;
    ollama) cmd=ollama; inst() { pkexec /usr/share/memora/bin/memora-admin software install ollama; }; rem() { pkexec /usr/share/memora/bin/memora-admin software remove ollama; } ;;
    node) cmd=node; inst() { mise use -g node@lts && mise reshim; }; rem() { mise unuse -g node; } ;;
    python) cmd=uv; inst() { mise use -g python@latest uv@latest && mise reshim; }; rem() { mise unuse -g python uv; } ;;
    go) cmd=go; inst() { mise use -g go@latest && mise reshim; }; rem() { mise unuse -g go; } ;;
    rust) cmd=cargo; inst() { pkexec /usr/share/memora/bin/memora-admin software install rust && rustup default stable; }; rem() { pkexec /usr/share/memora/bin/memora-admin software remove rust; } ;;
    bun) cmd=bun; inst() { mise use -g bun@latest && mise reshim; }; rem() { mise unuse -g bun; } ;;
    deno) cmd=deno; inst() { mise use -g deno@latest && mise reshim; }; rem() { mise unuse -g deno; } ;;
    flutter) cmd=flutter; inst() { memora-dev install flutter; }; rem() { mise unuse -g flutter; } ;;
    docker) cmd=docker; inst() { pkexec /usr/share/memora/bin/memora-admin software install docker; }; rem() { pkexec /usr/share/memora/bin/memora-admin software remove docker; } ;;
    virt-manager) cmd=virt-manager; inst() { pkexec /usr/share/memora/bin/memora-admin software install virt-manager; }; rem() { pkexec /usr/share/memora/bin/memora-admin software remove virt-manager; } ;;
    distrobox) cmd=distrobox; inst() { pkexec /usr/share/memora/bin/memora-admin software install distrobox; }; rem() { pkexec /usr/share/memora/bin/memora-admin software remove distrobox; } ;;
    platformio) cmd=pio; inst() { uv_ready && uv tool install platformio; }; rem() { uv tool uninstall platformio; } ;;
    arduino-cli) cmd=arduino-cli; inst() { pkexec /usr/share/memora/bin/memora-admin software install arduino-cli; }; rem() { pkexec /usr/share/memora/bin/memora-admin software remove arduino-cli; } ;;
    ngspice) cmd=ngspice; inst() { pkexec /usr/share/memora/bin/memora-admin software install ngspice; }; rem() { pkexec /usr/share/memora/bin/memora-admin software remove ngspice; } ;;
    *) return 1 ;;
  esac
}
IDS=(claude-desktop virt-manager distrobox platformio arduino-cli ngspice claude-code codex gemini-cli copilot-cli opencode qwen-code crush aider ollama node python go rust bun deno flutter docker)

case "${1:-}" in
  list)
    for id in "${IDS[@]}"; do recipe "$id" && command -v "$cmd" >/dev/null 2>&1 && echo "cli.$id"; done ;;
  install|remove)
    id="${2#cli.}"; recipe "$id" || { echo "Unknown tool $id"; exit 2; }
    if [[ $1 == install ]]; then inst; else rem; fi ;;
  open)
    id="${2#cli.}"; recipe "$id" || exit 2
    [[ $id == claude-desktop ]] && exec gtk-launch com.anthropic.Claude
    [[ $id == virt-manager ]] && exec virt-manager
    exec memora-float bash -lc "$cmd; exec bash" ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
