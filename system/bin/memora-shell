#!/usr/bin/env bash
# memora-shell — the desktop shell (menu bar, Dock, Launchpad, Control Center…).
#   memora-shell                 start it (from the Hyprland session)
#   memora-shell toggle NAME     launchpad | spotlight | control | calendar | switcher
#   memora-shell close
dir="${MEMORA_PATH:-/usr/share/memora}/shell"
# App Store apps (Flatpak) appear in this folder; it must exist before the shell
# starts, or the shell never sees apps installed later.
mkdir -p "$HOME/.local/share/flatpak/exports/share/applications" 2>/dev/null
case "${1:-}" in
  "") exec qs -p "$dir" ;;
  restart) pkill -f "qs -p $dir" ; sleep 0.3; exec uwsm app -- qs -p "$dir" ;;
  switch) exec qs -p "$dir" ipc call switcher "${2:-next}" ;;
  osd) exec qs -p "$dir" ipc call osd "$2" "${3:-up}" ;;
  lock) exec qs -p "$dir" ipc call lock lock ;;
  snap) exec qs -p "$dir" ipc call snap "${2:-end}" ;;
  window-menu) exec qs -p "$dir" ipc call windowmenu show "${2:-0}" ;;
  window-menu-keys) exec qs -p "$dir" ipc call windowmenu keys "${2:-0}" ;;
  minimize) exec qs -p "$dir" ipc call shell minimize ;;
  project) exec qs -p "$dir" ipc call display project ;;
  super-up) exec qs -p "$dir" ipc call switcher superUp ;;
  quit-app) exec qs -p "$dir" ipc call shell quitApp ;;
  hide-app) exec qs -p "$dir" ipc call shell hideApp ;;
  desktop) shift; exec qs -p "$dir" ipc call desktops "${1:-next}" "${2:-0}" ;;
  show-desktop) exec qs -p "$dir" ipc call shell showDesktop ;;
  share) shift; files=""; for f in "$@"; do files+="$(realpath -m -- "${f#file://}")"$'\n'; done
    exec qs -p "$dir" ipc call shell share "$files" ;;
  *) exec qs -p "$dir" ipc call shell "$@" ;;
esac
