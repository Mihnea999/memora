#!/usr/bin/env bash
# memora-ai — the assistant built into Memora.
#   memora-ai [window] [QUESTION]   open the Memora AI notch (and ask right away)
#   memora-ai ask QUESTION          answer in the terminal; piped input is attached
#   memora-ai explain-clipboard     ask about what is in the clipboard
#   memora-ai explain-last CMD      run CMD again and explain what went wrong
#   memora-ai remember FACT         add to the memory file;  memora-ai memory  opens it
#   memora-ai setup                 System Settings > Memora AI
dir="${MEMORA_PATH:-/usr/share/memora}"
memory="$HOME/.local/share/memora/ai/memory.md"

# Memora AI is the notch at the top of the screen, part of the desktop shell.
window() {
  local sh="$dir/shell"
  if [[ -n $* ]]; then exec qs -p "$sh" ipc call ai ask "$*"; fi
  exec qs -p "$sh" ipc call ai toggle
}

case "${1:-window}" in
  window) shift; window "$@" ;;
  ask) shift; exec python3 "$dir/ai/agent.py" ask "$@" ;;
  explain-clipboard) window "Explain this, briefly: $(wl-paste -n 2>/dev/null | head -c 6000)" ;;
  explain-last)
    shift; cmd="$*"
    [[ -n $cmd ]] || { echo "usage: memora-ai explain-last COMMAND"; exit 1; }
    out="$(bash -c "$cmd" 2>&1 | tail -n 60)"
    printf '%s\n' "$out" | python3 "$dir/ai/agent.py" ask "I ran \`$cmd\` and got the output below. What went wrong, and how do I fix it?" ;;
  remember) shift; mkdir -p "$(dirname "$memory")"; printf -- '- %s (%s)\n' "$*" "$(date +%F)" >> "$memory"; echo "Remembered." ;;
  memory) mkdir -p "$(dirname "$memory")"; touch "$memory"; exec xdg-open "$memory" ;;
  setup) exec memora-settings ai ;;
  status) python3 -c "import json,os;print(json.load(open(os.path.expanduser('~/.config/memora/ai.json'))))" 2>/dev/null || echo "not set up" ;;
  *) window "$@" ;;
esac
