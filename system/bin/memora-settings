#!/usr/bin/env bash
# memora-settings [pane] — System Settings. With one already open, brings it
# forward (from the Dock too) and switches its pane.
dir="${MEMORA_PATH:-/usr/share/memora}/shell"
source "${MEMORA_PATH:-/usr/share/memora}/lib/single.sh"
pane="${1:-}"
if memora_single memora-settings "$dir/settings.qml"; then
  [[ -n $pane ]] && qs -p "$dir/settings.qml" ipc call settings open "$pane"
  exit 0
fi
MEMORA_SETTINGS_PANE="${pane:-wifi}" exec qs -p "$dir/settings.qml"
