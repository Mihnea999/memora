#!/usr/bin/env bash
# Show the current theme's wallpaper (or ~/.config/memora/wallpaper.png if present).
img="$HOME/.config/memora/wallpaper.png"
[[ -f $img ]] || img="$HOME/.config/memora/current/wallpaper.png"
pkill -x swaybg 2>/dev/null
setsid uwsm app -- swaybg -i "$img" -m fill >/dev/null 2>&1 &
