#!/usr/bin/env bash
# memora-bootsync — keeps every system on this computer in the startup menu.
#
# The menu (systemd-boot) finds Windows by itself when Windows shares its EFI
# partition. When Windows lives on another disk, its boot files are copied
# here (and refreshed at every start, so Windows updates carry over). Other
# Linux systems that boot with GRUB or shim get a menu entry of their own.
# Prints the systems it found, one per line as "Name|menu entry", and keeps the
# list in /etc/memora/other-systems (the shell offers "Restart into …" from it).
set -uo pipefail
[[ $EUID == 0 ]] || { echo "Run as root." >&2; exit 1; }

ESP_TYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
esp="$(bootctl --print-esp-path 2>/dev/null)" || exit 0
own="$(findmnt -no SOURCE "$esp" 2>/dev/null)"
tmp="$(mktemp -d)"; trap 'umount -q "$tmp" 2>/dev/null; rmdir "$tmp"' EXIT

name_of() {
  case "${1,,}" in
    ubuntu) echo Ubuntu ;; fedora) echo Fedora ;; debian) echo Debian ;; opensuse*) echo openSUSE ;;
    manjaro) echo Manjaro ;; pop) echo "Pop!_OS" ;; linuxmint|mint) echo "Linux Mint" ;;
    arch|endeavouros) echo "Arch Linux" ;; zorin) echo "Zorin OS" ;; kali) echo Kali ;; *) echo "$1" ;;
  esac
}

# GRUB/shim systems on an EFI partition: an entry for each (the menu can only
# start programs on its own partition, so this is for ours only).
linux_entries() {
  local root=$1
  mkdir -p "$esp/loader/entries"
  for d in "$root"/EFI/*/; do
    d="$(basename "$d")"
    case "${d,,}" in boot|microsoft|systemd|linux|memora|tools) continue ;; esac
    local bin=""
    for f in shimx64.efi grubx64.efi; do [[ -f $root/EFI/$d/$f ]] && { bin=$f; break; }; done
    [[ -n $bin ]] || continue
    local n; n="$(name_of "$d")"
    printf 'title   %s\nefi     /EFI/%s/%s\nsort-key 50-%s\n' "$n" "$d" "$bin" "${d,,}" > "$esp/loader/entries/other-${d,,}.conf"
    echo "$n|other-${d,,}.conf"
  done
}

# Windows gets an entry of its own, named plainly (the menu's automatic one,
# "Windows Boot Manager", is turned off in loader.conf).
windows_entry() {
  mkdir -p "$esp/loader/entries"
  printf 'title   Windows\nefi     /EFI/Microsoft/Boot/bootmgfw.efi\nsort-key 10-windows\n' > "$esp/loader/entries/windows.conf"
  echo "Windows|windows.conf"
}

found=()
# Windows on our own EFI partition.
[[ -f $esp/EFI/Microsoft/Boot/bootmgfw.efi && ! -f $esp/EFI/Microsoft/.memora-copy ]] && found+=("$(windows_entry)")
mapfile -t -O "${#found[@]}" found < <(linux_entries "$esp")

# Windows on another disk.
while read -r p t; do
  [[ $t == "$ESP_TYPE" && $p != "$own" ]] || continue
  mount -o ro "$p" "$tmp" 2>/dev/null || continue
  if [[ -f $tmp/EFI/Microsoft/Boot/bootmgfw.efi && ! " ${found[*]} " =~ " Windows|" ]]; then
    if [[ ! -d $esp/EFI/Microsoft || -f $esp/EFI/Microsoft/.memora-copy ]]; then
      rm -rf "$esp/EFI/Microsoft.new"
      if cp -r "$tmp/EFI/Microsoft" "$esp/EFI/Microsoft.new"; then
        touch "$esp/EFI/Microsoft.new/.memora-copy"
        rm -rf "$esp/EFI/Microsoft"; mv "$esp/EFI/Microsoft.new" "$esp/EFI/Microsoft"
        found+=("$(windows_entry)")
      else
        rm -rf "$esp/EFI/Microsoft.new"
      fi
    fi
  fi
  umount -q "$tmp"
done < <(lsblk -lnpo PATH,PARTTYPE)

list="$(printf '%s\n' "${found[@]}" | awk 'NF && !seen[$0]++')"
# No Windows any more: no entry for it.
[[ " ${found[*]} " =~ " Windows|" ]] || rm -f "$esp/loader/entries/windows.conf"
mkdir -p /etc/memora
if [[ -n $list ]]; then printf '%s\n' "$list" > /etc/memora/other-systems; else rm -f /etc/memora/other-systems; fi
[[ -n $list ]] && printf '%s\n' "$list"
exit 0
