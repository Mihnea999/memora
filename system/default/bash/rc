# Memora bash defaults (updated with the system).
HISTSIZE=50000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize globstar 2>/dev/null
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

export EDITOR=nvim
export VISUAL=nvim
export PATH="$HOME/.local/bin:$PATH"

[[ -f /usr/share/bash-completion/bash_completion ]] && source /usr/share/bash-completion/bash_completion
command -v mise     >/dev/null && eval "$(mise activate bash)"
command -v zoxide   >/dev/null && eval "$(zoxide init bash)"
command -v fzf      >/dev/null && eval "$(fzf --bash)"
command -v starship >/dev/null && eval "$(starship init bash)"

alias ls='eza --group-directories-first'
alias ll='eza -l --git --group-directories-first'
alias la='eza -la --git --group-directories-first'
alias tree='eza --tree'
alias cat='bat --paging=never --style=plain'
alias g='git'
alias lg='lazygit'
alias v='nvim'

# Ask Memora AI from the shell:  ?? how do I find large files   (or: ai ...)
ai() { memora-ai ask "$*"; }
alias '??'='memora-ai ask' '?'='memora-ai ask'
# Explain why the last command failed
wtf() { memora-ai explain-last "$(fc -ln -2 -2 | sed "s/^[[:space:]]*//")"; }
source /usr/share/memora/lib/gum.sh
